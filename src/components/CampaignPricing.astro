---
// Y5Campaigns pricing: a campaign-size slider like the one on the Credits page
// of the Y5Media dashboard. It runs from the smallest campaign to 2 million
// emails, snaps to the price breaks, and the tier buttons under it jump to each
// break. Figures come from campaignPricing in site.ts (keep in step with
// config/pricing.php in the Y5Leads app).
import { campaignPricing } from '../config/site';
const { tiers, vat, minEmails } = campaignPricing;
const MAX = 2000000;
const short = (n: number) => (n >= 1000000 ? `${n / 1000000}M` : `${n / 1000}K`);
const fmt = (n: number) => n.toLocaleString('en-US');
const segments = tiers.map((t, i) => {
  const from = Math.max(minEmails, t.from);
  const to = tiers[i + 1] ? tiers[i + 1].from : MAX;
  return { from, to, rate: t.rate, label: tiers[i + 1] ? `${short(from)} to ${short(to)}` : `${short(from)} or more` };
});
const breaks = segments.slice(1).map((s) => s.from);
const start = 250000;
const rateFor = (n: number) => [...tiers].reverse().find((t) => n >= t.from)!.rate;
const pos = (n: number) => ((n - minEmails) / (MAX - minEmails)) * 100;
const credits = (n: number) => Math.round(n * rateFor(n));
---
<section class="pricing plum on-dark" id="pricing" data-camp-pricing data-min={minEmails} data-max={MAX} data-vat={vat} data-breaks={breaks.join(',')}>
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker" data-reveal>Y5Campaigns pricing</div>
        <h2 data-reveal>Pay per email. <span class="accent">Bigger campaigns cost less.</span></h2>
      </div>
      <p class="lede" data-reveal>Slide to your campaign size to see what it costs. Credits come off when you approve the proof, and any emails we couldn’t send come back to you. One credit is one dirham, the same balance you use for Y5Leads.</p>
    </div>

    <div class="calc" data-reveal>
      <div class="calc-main">
        <span class="calc-label">Campaign size</span>
        <p class="count"><b data-out="emails">{fmt(start)}</b> <span>emails</span></p>
        <div class="track">
          <label for="camp-size" class="visually-hidden">Campaign size in emails</label>
          <input id="camp-size" class="range" type="range" min={minEmails} max={MAX} step="10000" value={start}
            aria-valuetext={`${fmt(start)} emails`} style={`--fill: ${pos(start)}%`} />
          {breaks.map((b) => <span class="tick" aria-hidden="true" style={`left: ${pos(b)}%`} data-tick={b}></span>)}
        </div>
        <div class="scale" aria-hidden="true"><span>{short(minEmails)}</span><span>{short(MAX)}</span></div>
        <div class="segs">
          {segments.map((s) => (
            <button type="button" class="seg" data-from={s.from} data-to={s.to} style={`flex: ${s.to - s.from} 1 0`}
              aria-pressed={start >= s.from && start < s.to ? 'true' : 'false'}>
              <span>{s.label}</span>
              <b>AED {s.rate}</b>
              <small>per email</small>
            </button>
          ))}
        </div>
      </div>

      <div class="calc-out" aria-live="polite">
        <span class="calc-label">Your campaign</span>
        <p class="line"><span data-out="emails2">{fmt(start)}</span> emails × AED <span data-out="rate">{rateFor(start)}</span></p>
        <p class="total"><b data-out="credits">{fmt(credits(start))}</b> <span>credits</span></p>
        <p class="line">AED <span data-out="vat">{fmt(Math.round(credits(start) * (1 + vat / 100)))}</span> with {vat}% VAT</p>
        <a class="btn btn-violet" href="/contact?interest=y5campaigns">Start a campaign</a>
      </div>
    </div>
    <p class="fine">The smallest campaign is {fmt(minEmails)} emails. Need more than {short(MAX)}? <a href="/contact?interest=y5campaigns">Talk to us</a>.</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-camp-pricing]');
  if (root) {
    const min = Number(root.dataset.min), max = Number(root.dataset.max), vat = Number(root.dataset.vat);
    const breaks = (root.dataset.breaks || '').split(',').filter(Boolean).map(Number);
    const range = root.querySelector<HTMLInputElement>('.range')!;
    const segs = Array.from(root.querySelectorAll<HTMLButtonElement>('.seg'));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('[data-tick]'));
    const rates = segs.map((s) => ({ from: Number(s.dataset.from), rate: Number(s.querySelector('b')!.textContent!.replace(/[^\d.]/g, '')) }));
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const fmt = (n: number) => n.toLocaleString('en-US');
    const snap = (raw: number) => breaks.find((b) => Math.abs(b - raw) <= 40000) ?? Math.round(raw / 50000) * 50000;

    const set = (value: number) => {
      const n = Math.min(max, Math.max(min, value));
      const rate = [...rates].reverse().find((r) => n >= r.from)!.rate;
      const credits = Math.round(n * rate);
      range.value = String(n);
      range.style.setProperty('--fill', `${((n - min) / (max - min)) * 100}%`);
      range.setAttribute('aria-valuetext', `${fmt(n)} emails`);
      out('emails').textContent = fmt(n);
      out('emails2').textContent = fmt(n);
      out('rate').textContent = String(rate);
      out('credits').textContent = fmt(credits);
      out('vat').textContent = fmt(Math.round(credits * (1 + vat / 100)));
      segs.forEach((s) => s.setAttribute('aria-pressed', String(n >= Number(s.dataset.from) && (n < Number(s.dataset.to) || s === segs[segs.length - 1]))));
      ticks.forEach((t) => t.classList.toggle('on', n >= Number(t.dataset.tick)));
    };
    range.addEventListener('input', () => set(snap(Number(range.value))));
    segs.forEach((s) => s.addEventListener('click', () => set(Number(s.dataset.from))));
    set(Number(range.value));
  }
</script>

<style>
  .pricing { padding-block: var(--section); }
  .calc { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); padding: clamp(22px, 3vw, 36px); border-radius: var(--radius-lg); background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); }
  .calc-label { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--violet); }
  .count { margin: 10px 0 6px; display: flex; align-items: baseline; gap: 10px; }
  .count b { font-family: var(--font-display); font-size: clamp(40px, 4.4vw, 60px); font-weight: 600; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .count span { color: rgba(255, 255, 255, .7); }

  .track { position: relative; padding: 14px 0; }
  .range { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 10px; margin: 0; border-radius: 999px; cursor: pointer; outline: none;
    background: linear-gradient(90deg, var(--violet) var(--fill), rgba(255, 255, 255, .14) var(--fill)); }
  .range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 28px; height: 28px; border-radius: 50%; background: #fff; border: 4px solid #8B5CF6; box-shadow: 0 4px 14px rgba(0, 0, 0, .35); }
  .range::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: #fff; border: 4px solid #8B5CF6; box-shadow: 0 4px 14px rgba(0, 0, 0, .35); }
  .range:focus-visible { outline: 2px solid var(--violet); outline-offset: 6px; }
  .tick { position: absolute; top: 50%; width: 2px; height: 18px; margin: -9px 0 0 -1px; border-radius: 1px; background: rgba(255, 255, 255, .45); pointer-events: none; }
  .tick.on { background: var(--plum); opacity: .6; }
  .scale { display: flex; justify-content: space-between; font-size: 12.5px; color: rgba(255, 255, 255, .5); }

  .segs { display: flex; gap: 6px; margin-top: 18px; }
  .seg { min-width: 0; display: grid; gap: 2px; text-align: left; padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .04); color: var(--white); font: inherit; cursor: pointer; transition: background .25s, color .25s, border-color .25s; }
  .seg:hover { border-color: rgba(255, 255, 255, .4); }
  .seg span { font-size: 12.5px; font-weight: 600; opacity: .75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .seg b { font-family: var(--font-display); font-size: clamp(18px, 1.8vw, 24px); font-weight: 600; letter-spacing: -.02em; }
  .seg small { font-size: 12px; opacity: .65; }
  .seg[aria-pressed='true'] { background: var(--violet); border-color: var(--violet); color: var(--plum); }
  .seg:focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; }

  .calc-out { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: clamp(18px, 2.4vw, 28px); border-radius: var(--radius-md); background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .1); }
  .line { color: rgba(255, 255, 255, .72); font-variant-numeric: tabular-nums; }
  .total { margin: 6px 0 2px; display: flex; align-items: baseline; gap: 8px; }
  .total b { font-family: var(--font-display); font-size: clamp(34px, 3.4vw, 48px); font-weight: 600; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .total span { color: rgba(255, 255, 255, .7); }
  .btn-violet { margin-top: auto; background: var(--violet); color: var(--plum); }
  .calc-out .btn-violet { margin-top: 18px; }
  .fine { margin-top: 16px; font-size: 13px; color: rgba(255, 255, 255, .55); }
  .fine a { color: var(--violet); font-weight: 600; }
  @media (max-width: 960px) { .calc { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .segs { flex-direction: column; } .seg { flex: none !important; } }
</style>
