---
// Y5Campaigns pricing: the three per-email rates, and a size picker that works
// out the credits for a campaign. Figures come from campaignPricing in site.ts
// (keep in step with config/pricing.php in the Y5Leads app).
import { campaignPricing } from '../config/site';
const { tiers, sizes, vat, minEmails } = campaignPricing;
const rateFor = (n: number) => [...tiers].reverse().find((t) => n >= t.from)!.rate;
const short = (n: number) => (n >= 1000000 ? `${n / 1000000}M` : `${n / 1000}K`);
const fmt = (n: number) => n.toLocaleString('en-US');
const start = sizes[0];
---
<section class="pricing plum on-dark" id="pricing" data-camp-pricing>
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker" data-reveal>Y5Campaigns pricing</div>
        <h2 data-reveal>Pay per email. <span class="accent">Bigger campaigns cost less.</span></h2>
      </div>
      <p class="lede" data-reveal>Credits come off when you approve the proof, and any emails we couldn’t send come back to you. One credit is one dirham, the same balance you use for Y5Leads.</p>
    </div>

    <div class="tiers">
      {tiers.map((t, i) => (
        <article class="tier" data-tier={t.from} aria-current={i === 0 ? 'true' : undefined} data-reveal data-reveal-delay={`${i * 0.08}s`}>
          <span class="label">{t.label}</span>
          <p class="big"><small>AED</small>{t.rate}</p>
          <span class="per">per email</span>
        </article>
      ))}
    </div>

    <div class="calc" data-reveal>
      <span class="calc-label" id="camp-size-label">Campaign size</span>
      <div class="sizes" role="radiogroup" aria-labelledby="camp-size-label">
        {sizes.map((n, i) => (
          <button type="button" role="radio" class="size" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
            data-size={n} data-rate={rateFor(n)} data-from={[...tiers].reverse().find((t) => n >= t.from)!.from}>{short(n)}</button>
        ))}
      </div>
      <div class="out" aria-live="polite">
        <span><span data-out="emails">{fmt(start)}</span> emails × AED <span data-out="rate">{rateFor(start)}</span></span>
        <b><span data-out="total">{fmt(Math.round(start * rateFor(start)))}</span> credits</b>
      </div>
      <p class="fine">{vat}% VAT is added at checkout. The smallest campaign is {fmt(minEmails)} emails.</p>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-camp-pricing]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.size'));
    const tiers = Array.from(root.querySelectorAll<HTMLElement>('[data-tier]'));
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const pick = (btn: HTMLButtonElement, focus = false) => {
      buttons.forEach((b) => { const on = b === btn; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
      const n = Number(btn.dataset.size);
      const rate = Number(btn.dataset.rate);
      out('emails').textContent = n.toLocaleString('en-US');
      out('rate').textContent = String(rate);
      out('total').textContent = Math.round(n * rate).toLocaleString('en-US');
      tiers.forEach((t) => (t.dataset.tier === btn.dataset.from ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      if (focus) btn.focus();
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        pick(buttons[(i + step + buttons.length) % buttons.length], true);
      });
    });
  }
</script>

<style>
  .pricing { padding-block: var(--section); }
  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .tier { padding: 28px; border-radius: var(--radius-lg); border: 1px solid var(--glass-border); background: var(--glass); transition: background .3s, color .3s, border-color .3s; }
  .tier[aria-current='true'] { background: var(--violet); color: var(--plum); border-color: var(--violet); }
  .label { font-size: 13px; font-weight: 600; letter-spacing: .04em; opacity: .8; }
  .big { margin: 10px 0 2px; font-family: var(--font-display); font-size: clamp(40px, 4vw, 56px); font-weight: 600; line-height: 1; letter-spacing: -.03em; }
  .big small { font-size: .38em; margin-right: 6px; letter-spacing: 0; opacity: .8; }
  .per { font-size: 14px; opacity: .75; }
  .calc { margin-top: 24px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-lg); background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); }
  .calc-label { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--violet); }
  .sizes { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 22px; }
  .size { padding: 11px 18px; border-radius: var(--radius-pill); border: 1px solid rgba(255, 255, 255, .22); background: transparent; color: var(--white); font-weight: 600; font-size: 14px; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .size:hover { border-color: rgba(255, 255, 255, .5); }
  .size[aria-checked='true'] { background: var(--violet); color: var(--plum); border-color: var(--violet); }
  .size:focus-visible { outline-color: var(--violet); }
  .out { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, .12); }
  .out > span { color: rgba(255, 255, 255, .72); }
  .out b { font-family: var(--font-display); font-size: clamp(28px, 3vw, 40px); font-weight: 600; letter-spacing: -.03em; }
  .fine { margin-top: 14px; font-size: 13px; color: rgba(255, 255, 255, .55); }
  @media (max-width: 860px) { .tiers { grid-template-columns: 1fr; } }
</style>
