---
import Logo from './Logo.astro';
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
type Item = { label: string; href: string; note?: string; children?: readonly Item[] };
const isCurrent = (item: Item): boolean => path === item.href || (item.children ?? []).some((c) => path === c.href);
const LOGO = '/images/brand/y5-logo.svg';
---
<header class="nav on-dark" data-nav>
  <Logo />

  <nav class="links" aria-label="Main">
    {(site.nav as readonly Item[]).map((item) => item.children ? (
      <div class="svc-wrap">
        <button type="button" class="svc" aria-expanded="false" aria-controls="svc-menu" data-svc
          aria-current={isCurrent(item) ? 'page' : undefined}>
          {item.label} <span class="caret" aria-hidden="true"></span>
        </button>
        <div class="svc-menu" id="svc-menu" hidden data-svc-menu>
          {item.children.map((c) => (
            <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label.startsWith('Y5') ? <b class="y5n"><img src={LOGO} alt="Y5" width="326" height="168" />{c.label.slice(2)}</b> : <b>{c.label}</b>}<small>{c.note}</small></a>
          ))}
        </div>
      </div>
    ) : (
      <>
        <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
        {item.label === 'Contact' && (
          <div class="login-wrap">
            <button type="button" class="svc login" aria-expanded="false" aria-controls="login-menu" data-login>
              Log in <span class="caret" aria-hidden="true"></span>
            </button>
            <div class="login-menu" id="login-menu" hidden data-login-menu>
              {site.logins.map((l) => l.href ? (
                <a href={l.href}><b>{l.label}</b><small>{l.note}</small></a>
              ) : (
                <span class="soon"><b>{l.label}</b><small>Ask us for your login link</small></span>
              ))}
            </div>
          </div>
        )}
      </>
    ))}
  </nav>

  <div class="actions">
    <a class="signup" href={site.signup.href}>
      {site.signup.label}
      <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {(site.nav as readonly Item[]).map((item) => item.children ? (
      <>
        <span class="m-group">{item.label}</span>
        {item.children.map((c) => <a href={c.href}>{c.label.startsWith('Y5') ? <span class="y5n"><img src={LOGO} alt="Y5" width="326" height="168" />{c.label.slice(2)}</span> : c.label}</a>)}
      </>
    ) : <a href={item.href}>{item.label}</a>)}
    <span class="m-group">Log in</span>
    {site.logins.filter((l) => l.href).map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="m-signup" href={site.signup.href}>{site.signup.label}</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = (btn: HTMLButtonElement, panel: HTMLElement, open?: boolean) => {
    const next = open ?? btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(next));
    panel.hidden = !next;
  };

  const svcBtn = nav.querySelector<HTMLButtonElement>('[data-svc]');
  const svcMenu = nav.querySelector<HTMLElement>('[data-svc-menu]');
  if (svcBtn && svcMenu) svcBtn.addEventListener('click', () => toggle(svcBtn, svcMenu));

  const loginBtn = nav.querySelector<HTMLButtonElement>('[data-login]')!;
  const loginMenu = nav.querySelector<HTMLElement>('[data-login-menu]')!;
  loginBtn.addEventListener('click', () => toggle(loginBtn, loginMenu));

  const menuBtn = nav.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  menuBtn.addEventListener('click', () => toggle(menuBtn, menu));
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) toggle(menuBtn, menu, false); });

  document.addEventListener('pointerdown', (e) => {
    if (!(e.target as Element).closest('.login-wrap')) toggle(loginBtn, loginMenu, false);
    if (svcBtn && svcMenu && !(e.target as Element).closest('.svc-wrap')) toggle(svcBtn, svcMenu, false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (loginBtn.getAttribute('aria-expanded') === 'true') { toggle(loginBtn, loginMenu, false); loginBtn.focus(); }
    if (svcBtn && svcMenu && svcBtn.getAttribute('aria-expanded') === 'true') { toggle(svcBtn, svcMenu, false); svcBtn.focus(); }
    if (menuBtn.getAttribute('aria-expanded') === 'true') { toggle(menuBtn, menu, false); menuBtn.focus(); }
  });
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: flex; align-items: center; gap: 6px;
    height: 76px; padding: 0 var(--gutter);
    background: var(--forest); border-bottom: 1px solid rgba(255, 255, 255, .08);
    transition: box-shadow .3s;
  }
  .nav.is-scrolled { box-shadow: 0 12px 32px -12px rgba(0, 0, 0, .45); }
  .nav > :global(.logo) { margin-right: auto; }
  .links { position: absolute; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 2px; }
  .links > a, .svc {
    display: inline-flex; align-items: center; height: 40px; padding: 0 14px; border-radius: 10px;
    color: var(--on-dark-muted); font-size: 15px; font-weight: 500; white-space: nowrap;
    transition: background .18s, color .18s;
  }
  .links > a:hover, .svc:hover, .svc[aria-expanded='true'] { color: var(--white); background: rgba(255, 255, 255, .07); }
  .links > a[aria-current='page'], .svc[aria-current='page'] { color: var(--white); background: rgba(255, 255, 255, .10); }

  .svc-wrap { position: relative; }
  .svc { gap: 8px; cursor: pointer; background: transparent; border: 0; }
  .svc[aria-expanded='true'] .caret { transform: translateY(1px) rotate(-135deg); }
  .svc-menu {
    position: absolute; left: 50%; top: calc(100% + 14px); transform: translateX(-50%); width: 260px;
    display: grid; gap: 2px; padding: 6px; border-radius: 16px;
    background: var(--forest-2); border: 1px solid var(--glass-border);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6);
  }
  .svc-menu[hidden] { display: none; }
  .svc-menu a { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; color: var(--white); }
  .svc-menu a:hover, .svc-menu a[aria-current='page'] { background: rgba(255, 255, 255, .07); }
  .svc-menu b { font-size: 14px; font-weight: 600; }
  .svc-menu small { font-size: 12px; color: var(--on-dark-faint); }
  .y5n { font-family: var(--font-display); font-weight: 600; letter-spacing: -.04em; white-space: nowrap; }
  .svc-menu .y5n { font-size: 19px; line-height: 1.1; }
  .y5n img { display: inline-block; height: .74em; width: auto; margin-right: .03em; vertical-align: -.02em; }

  .actions { display: flex; align-items: center; gap: 8px; }
  .signup {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: 10px;
    background: var(--green); color: var(--forest); font-size: 14px; font-weight: 600; white-space: nowrap;
    box-shadow: 0 8px 20px -10px rgba(117, 182, 48, .8); transition: background .2s, transform .2s;
  }
  .signup:hover { background: var(--lime); }
  .signup svg { transition: transform .25s var(--ease-out); }
  .signup:hover svg { transform: translateX(3px); }
  .login-wrap { position: relative; }
  .caret { width: 7px; height: 7px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform .2s; }
  .login[aria-expanded='true'] .caret { transform: translateY(1px) rotate(-135deg); }
  .login-menu {
    position: absolute; left: 50%; transform: translateX(-50%); top: calc(100% + 14px); width: 240px;
    display: grid; gap: 2px; padding: 6px; border-radius: 16px;
    background: var(--forest-2); border: 1px solid var(--glass-border);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6);
  }
  .login-menu[hidden] { display: none; }
  .login-menu a, .login-menu .soon { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; color: var(--white); }
  .login-menu a:hover { background: rgba(255, 255, 255, .07); }
  .login-menu b { font-size: 14px; font-weight: 600; }
  .login-menu small { font-size: 12px; color: var(--on-dark-faint); }
  .login-menu .soon { opacity: .7; }

  .menu-btn {
    display: none; width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--glass-border); cursor: pointer;
    background: var(--glass); place-items: center;
  }
  .bars, .bars::before, .bars::after { display: block; width: 18px; height: 2px; background: var(--white); border-radius: 2px; transition: transform .25s var(--ease-out); }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -6px; }
  .bars::after { top: 6px; }
  .menu-btn[aria-expanded='true'] .bars { background: transparent; }
  .menu-btn[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu {
    position: absolute; top: calc(100% + 10px); right: var(--gutter); left: var(--gutter);
    background: var(--forest-2); border: 1px solid var(--glass-border); border-radius: var(--radius-md);
    padding: 8px; display: grid;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a { color: var(--white); font-weight: 500; padding: 14px 16px; border-radius: var(--radius-sm); }
  .mobile-menu a:hover { background: rgba(255, 255, 255, .08); }
  .mobile-menu .m-signup { margin-top: 8px; text-align: center; background: var(--green); color: var(--forest); font-weight: 600; }
  .mobile-menu .m-signup:hover { background: var(--lime); }
  .m-group { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--on-dark-faint); padding: 12px 16px 4px; }

  @media (max-width: 1080px) {
    .links { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 380px) { .signup { padding: 0 14px; } .signup svg { display: none; } }
</style>
