---
// Y5Leads background loop: the Y5Media 360 source sends leads along light
// paths to project cards; each card flashes as a lead lands, and a lead card
// cycles from blurred to unlocked. Pure SVG (SMIL), no script.
const paths = [
  { id: 'lf-p1', d: 'M640 230 C640 420 420 520 250 578', node: { x: 250, y: 600, name: 'Creek Vista' }, t: 0 },
  { id: 'lf-p2', d: 'M640 230 C600 470 300 600 130 738', node: { x: 130, y: 760, name: 'Marina Heights' }, t: 1.1 },
  { id: 'lf-p3', d: 'M640 230 C660 470 520 560 400 668', node: { x: 400, y: 690, name: 'Palm Residences' }, t: 2.3 },
  { id: 'lf-p4', d: 'M640 230 C560 560 420 700 290 818', node: { x: 290, y: 840, name: 'Emaar Beachfront' }, t: 3.2 },
];
const DUR = 4.4;
---
<div class="lf" aria-hidden="true">
  <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="lf-bg" cx="45%" cy="25%" r="80%">
        <stop offset="0" stop-color="#0F4A32" /><stop offset=".55" stop-color="#072A1C" /><stop offset="1" stop-color="#03140D" />
      </radialGradient>
      <radialGradient id="lf-core"><stop offset="0" stop-color="#F2FFD0" /><stop offset=".4" stop-color="#C4F25A" /><stop offset="1" stop-color="#C4F25A" stop-opacity="0" /></radialGradient>
      <pattern id="lf-dots" width="26" height="26" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.2" fill="#C4F25A" fill-opacity=".14" /></pattern>
      <radialGradient id="lf-fade" cx="40%" cy="45%" r="65%"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
      <mask id="lf-mask"><rect width="1440" height="900" fill="url(#lf-fade)" /></mask>
      <filter id="lf-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      <filter id="lf-soft"><feGaussianBlur stdDeviation="3.5" /></filter>
      {paths.map((p) => <path id={p.id} d={p.d} />)}
    </defs>

    <rect width="1440" height="900" fill="url(#lf-bg)" />
    <rect width="1440" height="900" fill="url(#lf-dots)" mask="url(#lf-mask)" />

    <!-- light paths -->
    {paths.map((p) => (
      <g>
        <use href={`#${p.id}`} fill="none" stroke="#C4F25A" stroke-opacity=".18" stroke-width="1.5" />
        <use href={`#${p.id}`} fill="none" stroke="#C4F25A" stroke-opacity=".5" stroke-width="1.5" stroke-dasharray="2 14">
          <animate attributeName="stroke-dashoffset" from="0" to="-160" dur="3s" repeatCount="indefinite" />
        </use>
      </g>
    ))}

    <!-- leads travelling -->
    {paths.map((p) => [0, 0.18, 0.32].map((lag, k) => (
      <circle r={k === 0 ? 5 : 3} fill="#E8FFB0" opacity={k === 0 ? 1 : 0.55} filter="url(#lf-glow)">
        <animateMotion dur={`${DUR}s`} repeatCount="indefinite" begin={`-${(p.t + lag).toFixed(2)}s`} keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".5 0 .5 1">
          <mpath href={`#${p.id}`} />
        </animateMotion>
      </circle>
    )))}

    <!-- source -->
    <g transform="translate(640 230)">
      <circle r="90" fill="url(#lf-core)" opacity=".25" />
      <circle r="24" fill="none" stroke="#C4F25A" stroke-opacity=".6">
        <animate attributeName="r" values="24;80" dur="2.4s" repeatCount="indefinite" />
        <animate attributeName="stroke-opacity" values=".6;0" dur="2.4s" repeatCount="indefinite" />
      </circle>
      <circle r="48" fill="none" stroke="#C4F25A" stroke-opacity=".35" stroke-dasharray="4 8">
        <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="18s" repeatCount="indefinite" />
      </circle>
      <circle r="20" fill="url(#lf-core)" filter="url(#lf-glow)" />
      <circle r="6" fill="#fff" />
      <text y="76" text-anchor="middle" class="lf-label">Y5MEDIA 360</text>
    </g>

    <!-- project cards -->
    {paths.map((p) => (
      <g transform={`translate(${p.node.x - 78} ${p.node.y - 22})`}>
        <rect width="156" height="44" rx="12" fill="#081E14" fill-opacity=".82" stroke="#fff" stroke-opacity=".16">
          <animate attributeName="stroke" values="#ffffff;#ffffff;#C4F25A;#ffffff" keyTimes="0;.86;.93;1" dur={`${DUR}s`} begin={`-${p.t}s`} repeatCount="indefinite" />
          <animate attributeName="stroke-opacity" values=".16;.16;1;.16" keyTimes="0;.86;.93;1" dur={`${DUR}s`} begin={`-${p.t}s`} repeatCount="indefinite" />
        </rect>
        <circle cx="18" cy="22" r="4.5" fill="#C4F25A" filter="url(#lf-glow)">
          <animate attributeName="r" values="4;4;7;4" keyTimes="0;.86;.93;1" dur={`${DUR}s`} begin={`-${p.t}s`} repeatCount="indefinite" />
        </circle>
        <text x="34" y="27" class="lf-node">{p.node.name}</text>
      </g>
    ))}

    <!-- a lead arriving, then unlocked -->
    <g transform="translate(36 648)" class="lf-pop">
      <animate attributeName="opacity" values="0;1;1;1;0" keyTimes="0;.08;.5;.88;1" dur="8s" repeatCount="indefinite" />
      <rect width="170" height="58" rx="12" fill="#0B261B" fill-opacity=".9" stroke="#C4F25A" stroke-opacity=".5" />
      <text x="14" y="22" class="lf-small">New lead · AED 2M – 3M</text>
      <g>
        <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;.5;.55;1" dur="8s" repeatCount="indefinite" />
        <rect x="14" y="32" width="96" height="12" rx="6" fill="#fff" fill-opacity=".55" filter="url(#lf-soft)" />
      </g>
      <g opacity="0">
        <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;.52;.57;1" dur="8s" repeatCount="indefinite" />
        <text x="14" y="45" class="lf-name">Rania K.</text>
        <rect x="112" y="31" width="44" height="18" rx="9" fill="#C4F25A" />
        <text x="134" y="44" text-anchor="middle" class="lf-chip">Called</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .lf { position: absolute; inset: 0; transition: opacity 1s, filter 1s; }
  .lf svg { width: 100%; height: 100%; display: block; }
  .lf-label { font: 600 11px var(--font-body); letter-spacing: .24em; fill: #C4F25A; }
  .lf-node { font: 600 13px var(--font-body); fill: #fff; }
  .lf-small { font: 500 11px var(--font-body); fill: rgba(255, 255, 255, .7); }
  .lf-name { font: 600 14px var(--font-body); fill: #fff; }
  .lf-chip { font: 700 10px var(--font-body); fill: #0B1A10; }
  :global(.hw[data-open='leads']) .lf { opacity: .28; filter: blur(2px); }
  :global(.hw[data-open='ads']) .lf { opacity: .3; }
  @media (prefers-reduced-motion: reduce) { .lf svg :global(animate), .lf svg :global(animateMotion) { display: none; } }
</style>
