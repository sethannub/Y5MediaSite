---
import { products } from '../../config/site';
---
<section class="hero forest on-dark">
  <div class="container grid">
    <div class="copy">
      <div class="kicker">WiFi advertising and lead generation in the UAE</div>
      <h1>Reach the right audience. <span class="accent">Generate more leads.</span></h1>
      <p class="lede">
        Put your brand in front of people as they connect to WiFi across the UAE, and get property buyer leads
        delivered straight to your team. Two ways to grow, one partner.
      </p>
      <div class="buttons">
        <a class="btn btn-primary" href={products.wifi.href}>Explore {products.wifi.name}</a>
        <a class="btn btn-glass" href={products.leads.href}>Explore {products.leads.name}</a>
      </div>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="glow"></div>
      <div class="phone">
        <div class="screen">
          <div class="bar">Mall Free WiFi</div>
          <div class="ad">
            <span class="tag">Ad</span>
            <small>This weekend only</small>
            <strong>Up to 40% off</strong>
            <span class="where">Electronics · Level 1</span>
          </div>
          <div class="go">Shop the offer</div>
          <div class="skip">Connect to the internet</div>
        </div>
      </div>

      <div class="float stat">
        <small>Impressions today</small>
        <b>12,480</b>
        <div class="spark">{[30, 42, 38, 55, 50, 68, 80, 74, 92].map((h) => <i style={`--h:${h}%`}></i>)}</div>
      </div>

      <div class="float lead">
        <div class="lead-top"><span class="dot"></span><small>New lead</small><em>Creek Vista</em></div>
        <b><span class="blur">Rania Khalil</span></b>
        <div class="lead-meta"><span>AED 2M – 3M</span><span>Dubai Creek</span></div>
        <span class="unlock">Unlock</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(130px, 14vw, 170px); padding-bottom: clamp(72px, 8vw, 110px); overflow: hidden; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 48px; align-items: center; }
  h1 { max-width: 13ch; }
  h1 .accent { display: block; }
  .lede { margin-top: 26px; }
  .buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .copy > * { animation: up .9s var(--ease-out) both; }
  .copy > :nth-child(2) { animation-delay: .08s; }
  .copy > :nth-child(3) { animation-delay: .16s; }
  .copy > :nth-child(4) { animation-delay: .24s; }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } }

  .visual { position: relative; height: 560px; display: grid; place-items: center; }
  .glow { position: absolute; inset: 10% 5%; border-radius: 50%; background: radial-gradient(closest-side, rgba(166, 231, 42, .28), transparent); filter: blur(20px); }

  .phone {
    position: relative; width: 250px; aspect-ratio: 250 / 510; border-radius: 40px; padding: 10px; background: #0A0F0C;
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .16), 0 50px 90px -30px rgba(0, 0, 0, .8);
    animation: in 1s var(--ease-out) .2s both;
  }
  .screen { height: 100%; border-radius: 31px; overflow: hidden; background: #F4F7F3; color: #14211A; padding: 40px 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .bar { text-align: center; font-size: 11px; font-weight: 600; color: #46544B; }
  .ad { flex: 1; border-radius: 16px; position: relative; padding: 16px; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; background: linear-gradient(160deg, #F59E0B, #DC2626 70%, #7C2D12); }
  .tag { position: absolute; top: 10px; left: 10px; font-size: 10px; font-weight: 700; background: rgba(0, 0, 0, .35); padding: 3px 7px; border-radius: 6px; }
  .ad small { font-size: 11px; opacity: .85; }
  .ad strong { font-family: var(--font-display); font-size: 27px; line-height: 1; }
  .where { font-size: 11px; opacity: .9; }
  .go { text-align: center; background: #14211A; color: #fff; border-radius: 11px; padding: 11px; font-size: 12px; font-weight: 600; }
  .skip { text-align: center; font-size: 11px; color: #5E6E64; }

  .float {
    position: absolute; border-radius: 18px; padding: 14px 16px; color: var(--white);
    background: linear-gradient(180deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .06));
    border: 1px solid rgba(255, 255, 255, .18); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), 0 24px 50px -20px rgba(0, 0, 0, .6);
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }
  .stat { left: 0; top: 16%; width: 200px; animation: in 1s var(--ease-out) .5s both, drift 7s ease-in-out 1.5s infinite; }
  .stat small { font-size: 12px; color: var(--on-dark-muted); }
  .stat b { display: block; font-family: var(--font-display); font-size: 28px; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .spark { display: flex; align-items: flex-end; gap: 4px; height: 36px; margin-top: 8px; }
  .spark i { flex: 1; height: var(--h); border-radius: 3px; background: linear-gradient(180deg, var(--lime), var(--green)); }

  .lead { right: 0; bottom: 14%; width: 250px; display: grid; gap: 6px; animation: in 1s var(--ease-out) .7s both, drift 8s ease-in-out 2s infinite reverse; }
  .lead-top { display: flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 10px var(--lime); }
  .lead-top small { font-size: 12px; color: var(--on-dark-muted); }
  .lead-top em { margin-left: auto; font-style: normal; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px; background: rgba(166, 231, 42, .16); color: var(--lime); }
  .lead b { font-family: var(--font-display); font-size: 19px; font-weight: 600; }
  .blur { filter: blur(6px); }
  .lead-meta { display: flex; gap: 10px; font-size: 12px; color: var(--on-dark-muted); }
  .unlock { justify-self: start; margin-top: 4px; font-size: 12px; font-weight: 600; padding: 7px 14px; border-radius: 999px; background: var(--green); color: #0B1A10; }

  @keyframes in { from { opacity: 0; transform: translateY(30px); } }
  @keyframes drift { 50% { transform: translateY(-10px); } }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .visual { height: 520px; }
  }
  @media (max-width: 520px) {
    .visual { height: 470px; }
    .phone { width: 210px; }
    .stat { width: 170px; top: 4%; }
    .lead { width: 220px; bottom: 2%; }
  }
</style>
