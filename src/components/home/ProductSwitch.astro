---
// One product at a time: a sticky switch picks WiFi Marketing or Y5Leads and
// only that product's sections show below it. Without JavaScript both show.
---
<section id="how-it-works" class="switch" data-switch>
  <div class="bar-wrap">
    <div class="bar" role="tablist" aria-label="Choose a product">
      <button type="button" role="tab" id="tab-wifi" aria-controls="pane-wifi" aria-selected="true" data-tab="wifi">
        <b>WiFi Marketing</b><small>For brands</small>
      </button>
      <button type="button" role="tab" id="tab-y5leads" aria-controls="pane-y5leads" aria-selected="false" tabindex="-1" data-tab="y5leads">
        <b>Y5Leads</b><small>For real estate</small>
      </button>
      <span class="glider" aria-hidden="true"></span>
    </div>
  </div>

  <div id="pane-wifi" role="tabpanel" aria-labelledby="tab-wifi" data-pane="wifi">
    <slot name="wifi" />
  </div>
  <div id="pane-y5leads" role="tabpanel" aria-labelledby="tab-y5leads" data-pane="y5leads">
    <slot name="y5leads" />
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-switch]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];

    const pick = (key: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === key;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panes.forEach((p) => { p.hidden = p.dataset.pane !== key; });
      root.dataset.active = key;
      root.querySelectorAll<HTMLElement>(`[data-pane="${key}"] [data-reveal]`).forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < innerHeight) el.classList.add('is-in');
      });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        const next = tabs[(i + 1) % tabs.length];
        pick(next.dataset.tab!);
        next.focus();
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        pick(a.dataset.pick!);
        root.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });

    pick(location.hash === '#y5leads' ? 'y5leads' : 'wifi');
  }
</script>

<style>
  .switch { position: relative; }
  .bar-wrap { position: sticky; top: 88px; z-index: 40; display: flex; justify-content: center; padding: 28px 16px 0; pointer-events: none; }
  .bar {
    pointer-events: auto; position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 5px; border-radius: 999px;
    background: rgba(11, 38, 27, .82); border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 18px 40px -16px rgba(11, 38, 27, .55);
    backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }
  .bar button {
    position: relative; z-index: 1; border: 0; background: none; cursor: pointer; color: var(--on-dark-muted);
    padding: 10px 26px; border-radius: 999px; display: grid; justify-items: center; line-height: 1.2; min-width: 170px;
    transition: color .3s;
  }
  .bar b { font-family: var(--font-display); font-weight: 600; font-size: 16px; }
  .bar small { font-size: 11.5px; opacity: .8; }
  .bar button[aria-selected='true'] { color: #0B1A10; }
  .bar button:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .glider {
    position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc(50% - 5px); border-radius: 999px;
    background: var(--green); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 6px 18px -6px rgba(117, 182, 48, .7);
    transition: transform .45s var(--ease-out);
  }
  [data-active='y5leads'] .glider { transform: translateX(100%); }
  :not([data-active]) > .bar-wrap .glider { display: none; }
  @media (max-width: 520px) {
    .bar button { min-width: 0; padding: 9px 16px; }
    .bar b { font-size: 15px; }
  }
</style>
