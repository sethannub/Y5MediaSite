---
// The home page hero (option A, chosen 14 Oct 2026, with option D's colours).
// A straight corner-to-corner divider: Y5Leads top left on dark emerald,
// Y5Ads bottom right on white. At rest each side shows only its label, name,
// one line and "Explore more". Clicking a side (not hovering: changed 19 Oct
// 2026 at the user's request) swings the divider so that side takes most of
// the screen, lays out its details and brings in its graphic: the live lead
// feed, or the laptop and phones. Each side is a link to its product page;
// the first click opens the side, a click on the open side follows the link.
import { products } from '../../config/site';
import LeadsFeed from './LeadsFeed.astro';
import AdsPhones from './AdsPhones.astro';
const LOGO = '/images/brand/y5-logo.svg';
---
<section class="slant on-dark" aria-label="Our products">
  <a class="pane leads" href={products.leads.href} aria-label="Explore Y5Leads" data-side="y5leads">
    <LeadsFeed />

    <div class="rest">
      <span class="kind">Buyer Leads</span>
      <h2 class="name"><img class="y5-logo" src={LOGO} alt="Y5" width="326" height="168" />Leads</h2>
      <p class="sub">Ready-to-call buyer leads, for every industry.</p>
      <span class="more-pill">Explore more <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </div>

    <div class="detail" aria-hidden="true">
      <span class="kind">Buyer Leads</span>
      <span class="name"><img class="y5-logo" src={LOGO} alt="" width="326" height="168" />Leads</span>
      <p class="sub">Real buyers from our own 360° marketing platform, in every industry from property to luxury cars. Unlock only the ones you want.</p>
      <span class="explore">Explore Y5Leads <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      <ul class="feats">
        <li><b>360°</b><span>own platform</span></li>
        <li><b>AED 250</b><span>per lead</span></li>
        <li><b>Refunds</b><span>for bad leads</span></li>
      </ul>
    </div>
  </a>

  <a class="pane ads" href={products.wifi.href} aria-label="Explore Y5Ads" data-side="y5ads">
    <AdsPhones />

    <div class="rest">
      <span class="kind">WiFi Display Ads</span>
      <h2 class="name"><img class="y5-logo" src={LOGO} alt="Y5" width="326" height="168" />Ads</h2>
      <p class="sub">Your ad on the WiFi login screen across the UAE.</p>
      <span class="more-pill">Explore more <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </div>

    <div class="detail" aria-hidden="true">
      <span class="kind">WiFi Display Ads</span>
      <span class="name"><img class="y5-logo" src={LOGO} alt="" width="326" height="168" />Ads</span>
      <p class="sub">WiFi display advertising: your banner or video on the WiFi login screen in malls, cafés, homes and staff accommodation.</p>
      <span class="explore">Explore Y5Ads <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      <ul class="feats">
        <li><b>Banner</b><span>&amp; video</span></li>
        <li><b>Location</b><span>targeting</span></li>
        <li><b>Live</b><span>reports</span></li>
      </ul>
    </div>
  </a>

  <div class="seam-wrap" aria-hidden="true"><div class="seam"></div></div>
  <button type="button" class="and" tabindex="-1" aria-label="Show both products" data-both>
    <span class="and-t" aria-hidden="true">AND</span>
    <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 7l-5 5 5 5M14 7l5 5-5 5" /></svg><small>Both</small></span>
  </button>
</section>

<script>
  const wide = matchMedia('(min-width: 961px)');
  const panes = Array.from(document.querySelectorAll<HTMLAnchorElement>('.slant [data-side]'));
  const activate = (product: string) => {
    panes.forEach((p) => p.classList.toggle('is-active', p.dataset.side === product));
    show(product);
  };
  let current = '';
  const show = (product: string) => {
    if (!wide.matches || product === current) return;
    current = product;
    document.querySelectorAll<HTMLElement>('[data-product]').forEach((sec) => {
      const on = sec.dataset.product === product;
      sec.hidden = !on;
      if (on) {
        sec.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => el.classList.add('is-in'));
        sec.classList.remove('product-in');
        void sec.offsetWidth;
        sec.classList.add('product-in');
      }
    });
  };
  const showAll = () => {
    current = '';
    document.querySelectorAll<HTMLElement>('[data-product]').forEach((sec) => { sec.hidden = false; });
  };
  panes.forEach((pane) => {
    const product = pane.dataset.side!;
    // Wide screens: the first click opens the side; a click on the open side follows the link.
    // Narrow screens show the details already, so a click goes straight to the product page.
    pane.addEventListener('click', (e) => {
      if (!wide.matches || pane.classList.contains('is-active')) return;
      e.preventDefault();
      activate(product);
    });
  });
  const both = document.querySelector<HTMLButtonElement>('.slant [data-both]')!;
  const reset = () => {
    panes.forEach((p) => p.classList.remove('is-active'));
    showAll();
    both.tabIndex = -1;
    if (location.hash === '#y5ads' || location.hash === '#y5leads') history.replaceState(null, '', location.pathname + location.search);
  };
  both.addEventListener('click', () => { if (panes.some((p) => p.classList.contains('is-active'))) reset(); });
  panes.forEach((pane) => pane.addEventListener('click', () => { if (wide.matches) both.tabIndex = 0; }));
  const fromHash = () => {
    const h = location.hash.slice(1);
    if (h === 'y5ads' || h === 'y5leads') { activate(h); both.tabIndex = 0; }
  };
  wide.addEventListener('change', () => { if (!wide.matches) reset(); });
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  @property --top { syntax: '<percentage>'; inherits: true; initial-value: 100%; }
  @property --bot { syntax: '<percentage>'; inherits: true; initial-value: 0%; }

  .slant {
    --top: 100%; --bot: 0%;
    --ease: cubic-bezier(.22, 1, .36, 1); --lime: #C4F25A;
    position: relative; height: 100svh; min-height: 700px; max-height: 1000px; overflow: hidden; background: #03140D;
    transition: --top 1s var(--ease), --bot 1s var(--ease);
  }
  .slant:has(.leads.is-active) { --top: 100%; --bot: 66%; }
  .slant:has(.ads.is-active) { --top: 34%; --bot: 0%; }

  .pane { position: absolute; inset: 0; overflow: hidden; display: block; outline: none; cursor: pointer; }
  .pane:focus-visible { outline: 3px solid var(--lime); outline-offset: -3px; }
  .leads { color: #fff; clip-path: polygon(0 0, var(--top) 0, var(--bot) 100%, 0 100%); }
  .ads { color: #0B1A10; clip-path: polygon(var(--top) 0, 100% 0, 100% 100%, var(--bot) 100%); }

  /* The divider and the AND badge on it */
  .seam-wrap { position: absolute; inset: 0; z-index: 5; pointer-events: none; filter: drop-shadow(0 0 8px rgba(117, 182, 48, .55)); }
  .seam {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, #75B630 0%, #C4F25A 40%, #fff 47%, #F2FFD0 50%, #C4F25A 56%, #75B630 100%); background-size: 100% 300%;
    clip-path: polygon(calc(var(--top) - 1px) 0, calc(var(--top) + 1px) 0, calc(var(--bot) + 1px) 100%, calc(var(--bot) - 1px) 100%);
    animation: sl-travel 4.5s linear infinite;
  }
  @keyframes sl-travel { from { background-position: 0 100%; } to { background-position: 0 0; } }
  .and {
    position: absolute; z-index: 6; left: calc((var(--top) + var(--bot)) / 2); top: 50%; transform: translate(-50%, -50%);
    width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; pointer-events: none;
    background: #fff; color: #0B261B; border: 0; padding: 0; font: inherit; outline: none;
    box-shadow: 0 0 0 1px rgba(11, 38, 27, .08), 0 0 0 9px rgba(255, 255, 255, .18), 0 22px 48px -16px rgba(0, 0, 0, .55);
    transition: background .5s, box-shadow .5s;
  }
  .and::before { content: ''; position: absolute; inset: 7px; border-radius: 50%; border: 1px solid rgba(11, 38, 27, .14); transition: border-color .5s; }
  .and::after { content: ''; position: absolute; inset: -9px; border-radius: 50%; border: 1.5px solid var(--lime); opacity: 0; animation: sl-halo 2.8s ease-out infinite; }
  @keyframes sl-halo { 0% { transform: scale(.95); opacity: .8; } 100% { transform: scale(1.35); opacity: 0; } }
  .and > * { grid-area: 1 / 1; transition: opacity .35s, transform .6s var(--ease); }
  .and-t { font: 700 15px var(--font-display); letter-spacing: .22em; padding-left: .22em; }
  .go { display: grid; justify-items: center; gap: 1px; opacity: 0; transform: scale(.6); }
  .go svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .go small { font: 700 9.5px var(--font-body); letter-spacing: .08em; }
  .and:focus-visible { box-shadow: 0 0 0 3px #0B261B, 0 0 0 6px var(--lime); }
  .slant:has(.pane.is-active) .and { pointer-events: auto; cursor: pointer; }
  .slant:has(.pane.is-active) .and:hover { transform: translate(-50%, -50%) scale(1.06); }

  .slant:has(.pane.is-active) .and { background: var(--lime); box-shadow: 0 0 0 1px rgba(11, 38, 27, .1), 0 0 0 9px rgba(196, 242, 90, .25), 0 0 40px -6px rgba(196, 242, 90, .7), 0 22px 48px -16px rgba(0, 0, 0, .55); }
  .slant:has(.pane.is-active) .and::before { border-color: rgba(11, 38, 27, .25); }
  .slant:has(.pane.is-active) .and-t { opacity: 0; transform: scale(.6); }
  .slant:has(.pane.is-active) .go { opacity: 1; transform: none; transition-delay: .25s; }

  /* ---------- Shared type ---------- */
  .kind { font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 10px; }
  .kind::before { content: ''; width: 22px; height: 1px; background: currentColor; opacity: .8; }
  .leads .kind { color: var(--lime); }
  .ads .kind { color: #2F6B00; }
  .name { font-family: var(--font-display); font-weight: 600; line-height: .9; letter-spacing: -.055em; white-space: nowrap; font-size: clamp(56px, 6vw, 104px); padding: 0 .08em .08em 0; }
  .leads .name { background: linear-gradient(180deg, #FFFFFF 30%, rgba(255, 255, 255, .72)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ads .name { background: linear-gradient(180deg, #0B1A10 30%, #24382B); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .y5-logo { display: inline-block; height: .74em; width: auto; margin-right: .03em; vertical-align: -.02em; }
  .sub { font-size: clamp(16px, 1.2vw, 19px); font-weight: 500; line-height: 1.45; max-width: 36ch; }
  .leads .sub { color: rgba(255, 255, 255, .82); }
  .ads .sub { color: #34463B; }

  /* ---------- At rest ---------- */
  .rest { position: absolute; z-index: 2; display: flex; flex-direction: column; gap: 14px; transition: opacity .45s, transform .9s var(--ease), filter .5s; }
  .leads .rest { left: 16%; top: max(150px, 22%); align-items: flex-start; }
  .ads .rest { right: 16%; bottom: 18%; align-items: flex-end; text-align: right; }
  .ads .rest .kind { flex-direction: row-reverse; }
  .more-pill {
    margin-top: 10px; display: inline-flex; align-items: center; gap: 12px; position: relative;
    font-size: 14px; font-weight: 600; padding: 14px 22px 14px 24px; border-radius: 999px;
    transition: background .3s, border-color .3s, color .3s, transform .4s var(--ease);
  }
  .leads .more-pill { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .3); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .ads .more-pill { background: #0B261B; color: #fff; border: 1px solid #0B261B; box-shadow: 0 14px 30px -14px rgba(11, 38, 27, .6); }
  .more-pill svg, .explore svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

  /* The open side's rest copy steps aside; the other side's fades away */
  .slant:has(.pane.is-active) .rest { opacity: 0; filter: blur(4px); pointer-events: none; }
  .leads.is-active .rest { transform: translateY(-24px); }
  .ads.is-active .rest { transform: translateY(24px); }

  /* ---------- Open side: the full layout ---------- */
  .detail { position: absolute; z-index: 3; top: 50%; transform: translateY(-50%); width: min(420px, 28vw); display: flex; flex-direction: column; align-items: flex-start; gap: 18px; pointer-events: none; }
  .leads .detail { left: 7%; }
  .ads .detail { left: 37%; width: min(390px, 26vw); }
  .detail > * { opacity: 0; transform: translateX(-30px); transition: opacity .35s, transform .8s var(--ease); }
  .pane.is-active .detail > * { opacity: 1; transform: none; }
  .pane.is-active .detail > :nth-child(1) { transition-delay: .25s; }
  .pane.is-active .detail > :nth-child(2) { transition-delay: .32s; }
  .pane.is-active .detail > :nth-child(3) { transition-delay: .39s; }
  .pane.is-active .detail > :nth-child(4) { transition-delay: .46s; }
  .pane.is-active .detail > :nth-child(5) { transition-delay: .55s; }
  .explore { display: inline-flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 600; padding: 16px 26px; border-radius: 999px; }
  .leads .explore { background: var(--lime); color: #0B1A10; box-shadow: 0 18px 40px -16px rgba(196, 242, 90, .7); }
  .ads .explore { background: #0B261B; color: #fff; box-shadow: 0 18px 40px -16px rgba(11, 38, 27, .6); }
  .feats { list-style: none; display: flex; width: 100%; padding-top: 16px; margin-top: 4px; }
  .feats li { flex: 1; display: grid; gap: 2px; padding-right: 14px; }
  .feats li + li { padding-left: 14px; }
  .feats b { font-family: var(--font-display); font-size: 17px; font-weight: 600; letter-spacing: -.01em; }
  .feats span { font-size: 13px; }
  .leads .feats { border-top: 1px solid rgba(255, 255, 255, .16); }
  .leads .feats li + li { border-left: 1px solid rgba(255, 255, 255, .14); }
  .leads .feats b { color: var(--lime); }
  .leads .feats span { color: rgba(255, 255, 255, .7); }
  .ads .feats { border-top: 1px solid rgba(11, 38, 27, .15); }
  .ads .feats li + li { border-left: 1px solid rgba(11, 38, 27, .12); }
  .ads .feats b { color: #2F6B00; }
  .ads .feats span { color: #46544B; }

  /* ---------- Graphics: hidden at rest, they come in when a side is opened ---------- */
  .leads :global(.lfd-stage) {
    left: 45%; top: 50%; bottom: auto; width: 360px; opacity: 0;
    transform: translateY(-44%) perspective(1200px) rotateY(-16deg) rotateX(4deg) scale(1.05); transform-origin: center;
    -webkit-mask-image: none; mask-image: none;
    transition: opacity .6s, transform 1.1s var(--ease);
  }
  .leads.is-active :global(.lfd-stage) { opacity: 1; transform: translateY(-50%) perspective(1200px) rotateY(-12deg) rotateX(3deg) scale(1.15); transition-delay: .3s; }

  .ads :global(.ap-cluster) { top: 50%; margin-top: -220px; left: calc(98% - 560px); opacity: 0; transform: translateY(40px); }
  .ads.is-active :global(.ap-cluster) { opacity: 1; transform: none; transition-delay: .3s; }
  .ads :global(.ap-rings) { opacity: 0; transition: opacity .6s; }
  .ads.is-active :global(.ap-rings) { opacity: 1; }

  /* ---------- Phones and tablets: stacked, details shown ---------- */
  @media (max-width: 960px) {
    .slant { height: auto; max-height: none; display: grid; gap: 8px; padding: 74px 8px 8px; }
    .pane { position: relative; clip-path: none; min-height: 460px; border-radius: 24px; }
    .seam-wrap, .and, .detail, .leads :global(.lfd-stage), .ads :global(.ap-cluster), .ads :global(.ap-rings) { display: none; }
    .rest { position: absolute; left: 24px !important; right: 24px !important; top: auto !important; bottom: 32px !important; align-items: flex-start !important; text-align: left !important; }
    .ads .rest .kind { flex-direction: row; }
    .slant:has(.pane.is-active) .rest { opacity: 1; filter: none; transform: none; }
    .name { font-size: 56px; }
  }
  :global([data-product].product-in) { animation: sl-product-in .7s var(--ease-out, ease) both; }
  @keyframes sl-product-in { from { opacity: 0; transform: translateY(24px); } }
  @media (prefers-reduced-motion: reduce) {
    :global([data-product].product-in) { animation: none; }
    .slant, .rest, .detail > * { transition: none; }
    .seam, .and::after, .go svg { animation: none; }
  }
</style>
