---
// Hero option A (CEO idea 1): the two products split by a steep slanted divider.
// Each side's copy sits where that side is widest: Y5Ads top left, Y5Leads
// bottom right. Hovering a side swings the slant towards the other one.
import { products } from '../../config/site';
---
<section class="slant on-dark" aria-label="Choose a product">
  <a class="pane ads" href={products.wifi.href}>
    <img class="photo" src="/images/hero/wifi.webp" alt="" width="1800" height="1125" fetchpriority="high" />
    <div class="copy">
      <span class="who">Y5Ads · WiFi advertising</span>
      <h2>Be seen the moment people connect.</h2>
      <p>Your banner or video on the WiFi login screen in malls, cafés, homes and staff accommodation across the UAE.</p>
      <ul class="facts"><li>Banner &amp; video</li><li>Location targeting</li><li>Live reports</li></ul>
      <span class="pick">Explore Y5Ads <span aria-hidden="true">→</span></span>
    </div>
    <div class="phone" aria-hidden="true"><div class="screen">
      <div class="bar"><span class="dot"></span>Free WiFi · Level 2</div>
      <div class="ad"><img src="/images/people/ad-coffee.webp" alt="" width="600" height="800" /><span class="tag">Ad</span><span class="txt"><small>Today only</small><b>Any coffee, AED 12</b></span></div>
      <div class="go">Get the offer</div>
      <div class="skip">Continue to the internet</div>
    </div></div>
  </a>

  <a class="pane leads" href={products.leads.href}>
    <img class="photo" src="/images/hero/y5leads.webp" alt="" width="1800" height="1125" />
    <img class="list" src="/images/y5leads/claim-1-leads.webp" alt="" width="1920" height="1200" aria-hidden="true" />
    <div class="copy">
      <span class="who">Y5Leads · Real estate</span>
      <h2>Property buyers, ready to call.</h2>
      <p>Leads matched to your projects from our own UAE database. Unlock only the ones you want, from AED 250 each.</p>
      <ul class="facts"><li>Matched to your projects</li><li>Pay per lead</li><li>Refunds for bad leads</li></ul>
      <span class="pick">Explore Y5Leads <span aria-hidden="true">→</span></span>
    </div>
  </a>

  <div class="seam" aria-hidden="true"></div>
  <span class="or" aria-hidden="true">or</span>
</section>

<style>
  @property --top { syntax: '<percentage>'; inherits: true; initial-value: 66%; }
  @property --bot { syntax: '<percentage>'; inherits: true; initial-value: 34%; }

  .slant {
    --top: 66%; --bot: 34%;
    position: relative; height: 100svh; min-height: 700px; max-height: 1000px; overflow: hidden; background: #08190f;
    transition: --top .9s var(--ease-out), --bot .9s var(--ease-out);
  }
  .slant:has(.ads:hover) { --top: 72%; --bot: 40%; }
  .slant:has(.leads:hover) { --top: 60%; --bot: 28%; }

  .pane { position: absolute; inset: 0; overflow: hidden; display: block; color: inherit; }
  .ads { background: #8CC63F; color: #0B1A10; clip-path: polygon(0 0, var(--top) 0, var(--bot) 100%, 0 100%); }
  .leads { background: #0B261B; color: var(--white); clip-path: polygon(var(--top) 0, 100% 0, 100% 100%, var(--bot) 100%); }
  .seam {
    position: absolute; inset: 0; pointer-events: none; background: var(--white);
    clip-path: polygon(calc(var(--top) - .12%) 0, calc(var(--top) + .12%) 0, calc(var(--bot) + .12%) 100%, calc(var(--bot) - .12%) 100%);
  }
  .or {
    position: absolute; z-index: 3; left: calc((var(--top) + var(--bot)) / 2); top: 50%; transform: translate(-50%, -50%);
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; pointer-events: none;
    font-family: var(--font-display); font-weight: 600; font-size: 15px; color: #0B1A10; background: var(--white);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, .18), 0 12px 30px -8px rgba(0, 0, 0, .45);
  }

  /* Photos stay in the background: a soft tint on the lime side, a dark wash on the green side */
  .photo { position: absolute; top: 0; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-out); }
  .ads .photo { left: 0; width: 70%; mix-blend-mode: multiply; opacity: .16; -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 85%); mask-image: linear-gradient(180deg, #000 30%, transparent 85%); }
  .leads .photo { right: 0; width: 75%; opacity: .3; mix-blend-mode: luminosity; -webkit-mask-image: linear-gradient(0deg, #000 20%, transparent 80%); mask-image: linear-gradient(0deg, #000 20%, transparent 80%); }
  .pane:hover .photo { transform: scale(1.04); }

  .copy { position: absolute; z-index: 2; width: min(500px, 34vw); display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .ads .copy { left: clamp(28px, 6vw, 96px); top: clamp(110px, 16vh, 150px); }
  .leads .copy { right: clamp(28px, 6vw, 96px); bottom: clamp(48px, 9vh, 88px); }
  .who { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ads .who { color: #1F3D0B; }
  .leads .who { color: var(--lime); }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 4.2vw, 64px); line-height: 1; letter-spacing: -.035em; }
  .copy p { font-size: 18px; line-height: 1.55; max-width: 42ch; font-weight: 500; }
  .ads .copy p { color: #1D3320; }
  .leads .copy p { color: #D5E3DA; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .facts li { font-size: 13px; font-weight: 600; padding: 7px 13px; border-radius: 999px; }
  .ads .facts li { background: rgba(11, 26, 16, .1); border: 1px solid rgba(11, 26, 16, .18); }
  .leads .facts li { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); }
  .pick { margin-top: 4px; font-weight: 600; font-size: 15px; padding: 15px 26px; border-radius: 999px; transition: transform .2s var(--ease-out), box-shadow .2s; }
  .ads .pick { background: #0B1A10; color: #fff; }
  .leads .pick { background: var(--lime); color: #0B1A10; }
  .pane:hover .pick { transform: translateY(-2px); box-shadow: 0 14px 30px -12px rgba(0, 0, 0, .5); }

  /* Y5Ads: a phone rising from the bottom edge, where the lime side narrows */
  .phone {
    position: absolute; left: clamp(28px, 6vw, 96px); bottom: -150px; width: 230px; height: 470px; border-radius: 38px; background: #0A0F0C; padding: 9px;
    transform: rotate(-4deg); box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .3), 0 40px 70px -26px rgba(0, 0, 0, .55);
    transition: transform .9s var(--ease-out), bottom .9s var(--ease-out);
  }
  .ads:hover .phone { bottom: -120px; transform: rotate(-2deg); }
  .screen { height: 100%; border-radius: 30px; overflow: hidden; background: #fff; padding: 34px 11px 11px; display: flex; flex-direction: column; gap: 8px; }
  .bar { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 10.5px; font-weight: 600; color: #46544B; }
  .bar .dot { width: 6px; height: 6px; border-radius: 50%; background: #75B630; }
  .ad { position: relative; flex: 1; border-radius: 15px; overflow: hidden; color: #fff; min-height: 0; }
  .ad img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ad::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, .7)); }
  .tag { position: absolute; z-index: 1; top: 8px; left: 8px; font-size: 9px; font-weight: 700; background: rgba(0, 0, 0, .5); padding: 2px 6px; border-radius: 5px; }
  .txt { position: absolute; z-index: 1; left: 11px; right: 11px; bottom: 11px; display: grid; }
  .txt small { font-size: 9.5px; opacity: .9; }
  .txt b { font-family: var(--font-display); font-size: 19px; line-height: 1.05; }
  .go { text-align: center; background: #14211A; color: #fff; border-radius: 10px; padding: 10px; font-size: 11px; font-weight: 600; }
  .skip { text-align: center; font-size: 10px; color: #5E6E64; }

  /* Y5Leads: the real leads list in the top corner, where the green side narrows */
  .list {
    position: absolute; right: -3%; top: clamp(96px, 13vh, 130px); width: 34%; max-width: none; border-radius: 14px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .14), 0 40px 80px -30px rgba(0, 0, 0, .7);
    transform: perspective(1600px) rotateY(-12deg) rotateX(3deg); transform-origin: right center;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent); mask-image: linear-gradient(180deg, #000 55%, transparent);
    transition: transform 1.2s var(--ease-out);
  }
  .leads:hover .list { transform: perspective(1600px) rotateY(-6deg) rotateX(2deg); }

  @media (max-width: 1100px) {
    .copy { width: min(440px, 40vw); }
    h2 { font-size: clamp(34px, 4vw, 52px); }
  }
  @media (max-width: 960px) {
    .slant { height: auto; max-height: none; display: grid; padding-top: 70px; }
    .pane { position: relative; clip-path: none; min-height: 520px; }
    .seam, .or, .phone, .list { display: none; }
    .ads .photo, .leads .photo { width: 100%; }
    .copy { position: absolute; left: 24px !important; right: 24px !important; top: auto !important; bottom: 40px !important; width: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .slant { transition: none; } }
</style>
