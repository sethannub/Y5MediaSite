---
// Y5Ads background loop: a cluster of phones floating in 3D, each cycling
// through WiFi login ads, with signal rings, light streaks and impressions
// counting up. CSS only.
const ads = [
  { kind: 'img', src: '/images/people/ad-coffee.webp', small: 'Today only', big: 'Any coffee, AED 12', cta: 'Get the offer' },
  { kind: 'sale', small: 'Weekend sale', big: 'Up to 40% off', cta: 'Shop now' },
  { kind: 'img', src: '/images/hero/y5leads-hd.webp', small: 'New launch', big: 'Creek Vista from AED 1.2M', cta: 'Book a viewing' },
  { kind: 'money', small: 'Send money home', big: 'Zero fees today', cta: 'Learn more' },
];
const phones = [0, 1, 2];
---
<div class="ap" aria-hidden="true">
  <div class="ap-bg"></div>
  <svg class="ap-streaks" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    {[0, 1, 2, 3, 4].map((i) => (
      <line x1={760 + i * 150} y1="-40" x2={260 + i * 150} y2="940" stroke="#C4F25A" stroke-opacity=".5" stroke-width="1.2" stroke-dasharray="60 900" style={`animation-delay:-${i * 1.4}s`} />
    ))}
  </svg>

  <div class="ap-rings"><i></i><i></i><i></i></div>

  <div class="ap-cluster">
    <div class="ap-tilt">
      {phones.map((p) => (
        <div class={`ap-phone ph${p}`}>
          <div class="ap-screen">
            <span class="ap-bar"><svg viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M2 9a15 15 0 0 1 20 0" /></svg>Free WiFi</span>
            <div class="ap-slides">
              {ads.map((a, i) => (
                <div class={`ap-slide ${a.kind}`} style={`animation-delay:-${(i * 3 + p * 1.5) % 12}s`}>
                  {a.src && <img src={a.src} alt="" width="600" height="800" loading="lazy" />}
                  <span class="ap-tag">Ad</span>
                  <span class="ap-txt"><small>{a.small}</small><b>{a.big}</b></span>
                  <span class="ap-cta">{a.cta}</span>
                </div>
              ))}
            </div>
            <span class="ap-skip">Continue to the internet</span>
          </div>
        </div>
      ))}
    </div>
    <span class="ap-plus pl1">+1 impression</span>
    <span class="ap-plus pl2">+1 click</span>
    <span class="ap-plus pl3">+1 impression</span>
  </div>
</div>

<style>
  .ap { position: absolute; inset: 0; overflow: hidden; }
  .ap-bg { position: absolute; inset: 0; background:
    radial-gradient(55% 60% at 80% 32%, rgba(166, 231, 42, .32), transparent 65%),
    radial-gradient(70% 70% at 100% 100%, rgba(166, 231, 42, .25), transparent 60%),
    linear-gradient(200deg, #1F5A2A 0%, #0D3A22 50%, #072A18 100%); }
  .ap-streaks { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ap-streaks line { animation: ap-streak 7s linear infinite; filter: drop-shadow(0 0 4px #C4F25A); }
  @keyframes ap-streak { to { stroke-dashoffset: -960; } }

  .ap-rings { position: absolute; left: 80%; top: 38%; width: 0; height: 0; }
  .ap-rings i { position: absolute; left: -300px; top: -300px; width: 600px; height: 600px; border-radius: 50%; border: 1px solid rgba(196, 242, 90, .4); opacity: 0; animation: ap-ring 4.2s ease-out infinite; }
  .ap-rings i:nth-child(2) { animation-delay: 1.4s; } .ap-rings i:nth-child(3) { animation-delay: 2.8s; }
  @keyframes ap-ring { 0% { transform: scale(.25); opacity: .8; } 100% { transform: scale(1.2); opacity: 0; } }

  .ap-cluster { position: absolute; left: 66%; top: 15%; width: 400px; height: 360px; perspective: 1400px; transition: opacity .8s, transform 1.2s cubic-bezier(.16, 1, .3, 1); }
  .ap-tilt { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(16deg) rotateY(-16deg) rotateZ(-8deg); }
  .ap-phone {
    position: absolute; width: 132px; height: 272px; border-radius: 28px; padding: 6px;
    background: linear-gradient(145deg, #4A524E, #151917 40%, #2E3431);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .22), 0 0 60px -14px rgba(196, 242, 90, .5), 0 40px 70px -30px rgba(0, 0, 0, .9);
    animation: ap-float 6s ease-in-out infinite;
  }
  .ph0 { left: 0; top: 54px; transform: translateZ(-60px); animation-delay: -2s; }
  .ph1 { left: 132px; top: 0; transform: translateZ(40px); width: 150px; height: 308px; }
  .ph2 { left: 282px; top: 64px; transform: translateZ(-60px); animation-delay: -4s; }
  @keyframes ap-float { 50% { translate: 0 -12px; } }
  .ap-screen { height: 100%; border-radius: 22px; overflow: hidden; background: #fff; padding: 22px 7px 7px; display: flex; flex-direction: column; gap: 6px; }
  .ap-bar { display: flex; align-items: center; justify-content: center; gap: 4px; font: 600 8px var(--font-body); color: #46544B; }
  .ap-bar svg { width: 10px; height: 10px; fill: none; stroke: #2F6B00; stroke-width: 2.4; stroke-linecap: round; animation: ap-sig 1.6s ease-in-out infinite; }
  @keyframes ap-sig { 50% { opacity: .35; } }
  .ap-slides { position: relative; flex: 1; border-radius: 14px; overflow: hidden; }
  .ap-slide { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 9px; color: #fff; opacity: 0; animation: ap-slide 12s infinite; }
  @keyframes ap-slide { 0% { opacity: 0; transform: scale(1.08); } 3%, 25% { opacity: 1; transform: none; } 28%, 100% { opacity: 0; } }
  .ap-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }
  .ap-slide::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, .75)); }
  .ap-slide.sale { background: linear-gradient(160deg, #F59E0B, #DC2626 70%, #7C2D12); }
  .ap-slide.money { background: linear-gradient(160deg, #0EA5E9, #0F766E 70%, #064E3B); }
  .ap-tag { position: absolute; top: 6px; left: 6px; font: 700 7px var(--font-body); background: rgba(0, 0, 0, .5); padding: 1px 5px; border-radius: 4px; }
  .ap-txt { display: grid; }
  .ap-txt small { font: 500 8px var(--font-body); opacity: .9; }
  .ap-txt b { font: 700 14px/1.05 var(--font-display); letter-spacing: -.02em; }
  .ph1 .ap-txt b { font-size: 16px; }
  .ap-cta { text-align: center; background: #fff; color: #0B1A10; border-radius: 8px; padding: 5px; font: 700 8px var(--font-body); }
  .ap-skip { text-align: center; font: 500 7px var(--font-body); color: #5E6E64; }

  .ap-plus {
    position: absolute; font: 600 12px var(--font-body); color: #0B1A10; background: #C4F25A; padding: 5px 10px; border-radius: 999px;
    box-shadow: 0 8px 20px -6px rgba(196, 242, 90, .8); opacity: 0; animation: ap-plus 4.5s ease-out infinite;
  }
  .pl1 { left: 40px; top: 30px; }
  .pl2 { left: 230px; top: -10px; animation-delay: 1.5s; background: #fff; }
  .pl3 { left: 330px; top: 60px; animation-delay: 3s; }
  @keyframes ap-plus { 0% { opacity: 0; transform: translateY(20px) scale(.8); } 12% { opacity: 1; transform: none; } 55% { opacity: 1; } 75%, 100% { opacity: 0; transform: translateY(-40px); } }

  :global(.hw[data-open='ads']) .ap-cluster, :global(.hw[data-open='leads']) .ap-cluster { opacity: 0; transform: scale(.9) translateY(-30px); }
  :global(.hw[data-open='ads']) .ap-rings { opacity: .5; }

  @media (prefers-reduced-motion: reduce) {
    .ap *, .ap { animation: none !important; }
    .ap-slide:first-child { opacity: 1; }
  }
</style>
