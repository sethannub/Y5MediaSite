---
// Y5Ads background loop, light: a laptop and two phones on the WiFi login
// page, each cycling through ads, on white with soft green motifs. CSS only.
const ads = [
  { kind: 'img', src: '/images/people/ad-coffee.webp', small: 'Today only', big: 'Any coffee, AED 12', cta: 'Get the offer' },
  { kind: 'sale', small: 'Weekend sale', big: 'Up to 40% off', cta: 'Shop now' },
  { kind: 'img', src: '/images/hero/y5leads-hd.webp', small: 'New launch', big: 'Creek Vista from AED 1.2M', cta: 'Book a viewing' },
  { kind: 'money', small: 'Send money home', big: 'Zero fees today', cta: 'Learn more' },
];
const slides = (offset: number) => ads.map((a, i) => ({ ...a, delay: (i * 3 + offset) % 12 }));
---
<div class="ap" aria-hidden="true">
  <div class="ap-bg"></div>
  <svg class="ap-motif" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <circle cx="1180" cy="300" r="200" fill="none" stroke="#75B630" stroke-opacity=".18" />
    <circle cx="1180" cy="300" r="270" fill="none" stroke="#75B630" stroke-opacity=".12" stroke-dasharray="3 9" class="ap-spin" />
    
  </svg>

  <div class="ap-rings"><i></i><i></i></div>

  <div class="ap-cluster">
    <div class="ap-laptop">
      <div class="ap-lid">
        <div class="ap-portal">
          <div class="ap-ptop"><span class="ap-logo">Y5</span><span>Free WiFi · Dubai Mall</span><span class="ap-wifi"><svg viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M2 9a15 15 0 0 1 20 0" /></svg></span></div>
          <div class="ap-slides wide">
            {slides(1).map((a) => (
              <div class={`ap-slide ${a.kind}`} style={`animation-delay:-${a.delay}s`}>
                {a.src && <img src={a.src} alt="" width="600" height="800" loading="lazy" />}
                <span class="ap-tag">Ad</span>
                <span class="ap-txt"><small>{a.small}</small><b>{a.big}</b></span>
                <span class="ap-cta">{a.cta}</span>
              </div>
            ))}
          </div>
          <span class="ap-connect">Connect to the internet</span>
        </div>
      </div>
      <div class="ap-deck"></div>
    </div>

    {[0, 1].map((p) => (
      <div class={`ap-phone ph${p}`}>
        <div class="ap-screen">
          <span class="ap-bar"><svg viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M2 9a15 15 0 0 1 20 0" /></svg>Free WiFi</span>
          <div class="ap-slides">
            {slides(p === 0 ? 7 : 4).map((a) => (
              <div class={`ap-slide ${a.kind}`} style={`animation-delay:-${a.delay}s`}>
                {a.src && <img src={a.src} alt="" width="600" height="800" loading="lazy" />}
                <span class="ap-tag">Ad</span>
                <span class="ap-txt"><small>{a.small}</small><b>{a.big}</b></span>
                <span class="ap-cta">{a.cta}</span>
              </div>
            ))}
          </div>
          <span class="ap-skip">Continue to the internet</span>
        </div>
      </div>
    ))}

    <span class="ap-plus">+1 impression</span>
  </div>
</div>

<style>
  .ap { position: absolute; inset: 0; overflow: hidden; }
  .ap-bg { position: absolute; inset: 0; background:
    radial-gradient(45% 55% at 80% 32%, rgba(196, 242, 90, .28), transparent 70%),
    radial-gradient(60% 60% at 100% 100%, rgba(117, 182, 48, .16), transparent 65%),
    linear-gradient(200deg, #FFFFFF 0%, #F6F9F3 55%, #ECF3E6 100%); }
  .ap-motif { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ap-spin { transform-origin: 1180px 300px; animation: ap-spin 60s linear infinite; }
  @keyframes ap-spin { to { transform: rotate(360deg); } }

  .ap-rings { position: absolute; left: 82%; top: 34%; width: 0; height: 0; z-index: 0; }
  .ap-rings i { position: absolute; left: -260px; top: -260px; width: 520px; height: 520px; border-radius: 50%; border: 1px solid rgba(117, 182, 48, .22); opacity: 0; animation: ap-ring 5s ease-out infinite; }
  .ap-rings i:nth-child(2) { animation-delay: 2.5s; }
  @keyframes ap-ring { 0% { transform: scale(.25); opacity: .9; } 100% { transform: scale(.8); opacity: 0; } }

  .ap-cluster { position: absolute; z-index: 1; left: calc(97.5% - 540px); top: 13%; width: 540px; height: 400px; transform-origin: right top; scale: .85; transition: opacity .8s, transform 1.2s cubic-bezier(.16, 1, .3, 1); }

  .ap-laptop { position: absolute; left: 20px; top: 40px; width: 350px; transform: perspective(1400px) rotateY(14deg) rotateX(4deg); animation: ap-float 8s ease-in-out infinite; }
  .ap-lid { border-radius: 12px 12px 4px 4px; padding: 7px 7px 10px; background: linear-gradient(180deg, #2A302D, #121614); box-shadow: 0 0 0 1px rgba(0, 0, 0, .1), 0 40px 70px -30px rgba(20, 50, 30, .45); }
  .ap-portal { aspect-ratio: 16 / 10; border-radius: 5px; background: #fff; display: flex; flex-direction: column; gap: 6px; padding: 8px; overflow: hidden; }
  .ap-ptop { display: flex; align-items: center; gap: 8px; font: 600 9px var(--font-body); color: #46544B; }
  .ap-logo { font: 800 9px var(--font-display); color: #fff; background: #0B261B; border-radius: 4px; padding: 2px 4px; }
  .ap-wifi { margin-left: auto; }
  .ap-wifi svg { width: 11px; height: 11px; fill: none; stroke: #2F6B00; stroke-width: 2.4; stroke-linecap: round; }
  .ap-connect { align-self: center; font: 600 8px var(--font-body); color: #fff; background: #0B261B; padding: 5px 14px; border-radius: 999px; }
  .ap-deck { height: 11px; margin: 0 -7%; border-radius: 2px 2px 14px 14px; background: linear-gradient(180deg, #F1F4F2 0%, #C3CBC6 60%, #8E9792 100%); box-shadow: 0 18px 24px -14px rgba(20, 50, 30, .45); }

  .ap-phone {
    position: absolute; width: 132px; height: 272px; border-radius: 28px; padding: 6px;
    background: linear-gradient(145deg, #3B423E, #121614 45%, #2A302D);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .12), 0 40px 60px -26px rgba(20, 50, 30, .5);
    animation: ap-float 6s ease-in-out infinite;
  }
  .ph0 { left: 290px; top: 0; width: 142px; height: 292px; transform: rotate(-6deg); }
  .ph1 { left: 418px; top: 82px; width: 122px; height: 252px; transform: rotate(5deg); animation-delay: -3s; }
  @keyframes ap-float { 50% { translate: 0 -10px; } }
  .ap-screen { height: 100%; border-radius: 22px; overflow: hidden; background: #fff; padding: 22px 7px 7px; display: flex; flex-direction: column; gap: 6px; }
  .ap-bar { display: flex; align-items: center; justify-content: center; gap: 4px; font: 600 8px var(--font-body); color: #46544B; }
  .ap-bar svg { width: 10px; height: 10px; fill: none; stroke: #2F6B00; stroke-width: 2.4; stroke-linecap: round; }

  .ap-slides { position: relative; flex: 1; border-radius: 12px; overflow: hidden; }
  .ap-slide { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 5px; padding: 8px; color: #fff; opacity: 0; animation: ap-slide 12s infinite; }
  @keyframes ap-slide { 0% { opacity: 0; transform: scale(1.06); } 3%, 25% { opacity: 1; transform: none; } 28%, 100% { opacity: 0; } }
  .ap-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }
  .ap-slide::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, .72)); }
  .ap-slide.sale { background: linear-gradient(160deg, #F59E0B, #DC2626 70%, #7C2D12); }
  .ap-slide.money { background: linear-gradient(160deg, #0EA5E9, #0F766E 70%, #064E3B); }
  .ap-tag { position: absolute; top: 6px; left: 6px; font: 700 7px var(--font-body); background: rgba(0, 0, 0, .5); padding: 1px 5px; border-radius: 4px; }
  .ap-txt { display: grid; }
  .ap-txt small { font: 500 8px var(--font-body); opacity: .9; }
  .ap-txt b { font: 700 14px/1.05 var(--font-display); letter-spacing: -.02em; }
  .wide .ap-slide { flex-direction: row; align-items: flex-end; justify-content: space-between; padding: 10px 12px; }
  .wide .ap-txt b { font-size: 15px; }
  .ap-cta { text-align: center; background: #fff; color: #0B1A10; border-radius: 8px; padding: 5px 8px; font: 700 8px var(--font-body); }
  .ap-skip { text-align: center; font: 500 7px var(--font-body); color: #5E6E64; }

  .ap-plus {
    position: absolute; left: 350px; top: -20px; font: 600 12px var(--font-body); color: #fff; background: #2F6B00; padding: 5px 11px; border-radius: 999px;
    box-shadow: 0 10px 20px -8px rgba(47, 107, 0, .6); opacity: 0; animation: ap-plus 5s ease-out infinite;
  }
  @keyframes ap-plus { 0% { opacity: 0; transform: translateY(16px) scale(.85); } 12% { opacity: 1; transform: none; } 55% { opacity: 1; } 75%, 100% { opacity: 0; transform: translateY(-30px); } }

  :global(.hw[data-open='ads']) .ap-cluster, :global(.hw[data-open='leads']) .ap-cluster { opacity: 0; transform: scale(.92) translateY(-30px); }

  @media (prefers-reduced-motion: reduce) {
    .ap *, .ap { animation: none !important; }
    .ap-slide:first-child { opacity: 1; }
  }
</style>
