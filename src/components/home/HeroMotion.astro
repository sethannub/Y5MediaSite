---
// Hero option D: option C's split and behaviour, with looping motion
// graphics (LeadsFlow, AdsPhones) in place of the background photos.
// Based on option C. Two cinematic halves split by one fine S-curve: Y5Leads
// (Dubai at night, deep emerald) top left, Y5Ads (mall shopper, bright green)
// bottom right. At rest: the names, a line each, and quiet ambient motion.
// Clicking a side sweeps the curve to about 80/20 and that product's scene
// builds in: device, floating cards, counters. The other side becomes a strip.
import { products } from '../../config/site';
import LeadsFeed from './LeadsFeed.astro';
import AdsPhones from './AdsPhones.astro';

const N = 18;
const ks = Array.from({ length: N + 1 }, (_, i) => {
  const s = 1 - i / N;
  const smooth = 3 * s * s - 2 * s * s * s;
  return { y: +((i / N) * 100).toFixed(2), k: +(0.45 * s + 0.55 * smooth).toFixed(4) };
});
const xAt = (k: number, off = '0px') => `calc(var(--b) + (var(--t) - var(--b)) * ${k} + ${off})`;
const curve = ks.map((p) => `${xAt(p.k)} ${p.y}%`).join(', ');
const leadsClip = `polygon(0 0, ${curve}, 0 100%)`;
const adsClip = `polygon(${curve}, 100% 100%, 100% 0)`;
const seamClip = `polygon(${ks.map((p) => `${xAt(p.k, '-.7px')} ${p.y}%`).join(', ')}, ${[...ks].reverse().map((p) => `${xAt(p.k, '.7px')} ${p.y}%`).join(', ')})`;

const sparks = Array.from({ length: 14 }, (_, i) => ({
  l: (i * 37) % 100, d: (i * 1.3) % 9, s: 7 + (i % 5) * 1.6, z: 2 + (i % 3) * 1.5,
}));
---
<section class="hw on-dark" data-hw data-variant="motion" data-open="none" aria-label="Our products">
  <!-- ================= Y5Leads ================= -->
  <div class="pane leads" style={`clip-path: ${leadsClip}`}>
    <LeadsFeed />

    <div class="rest">
      <span class="kind">Real Estate Leads</span>
