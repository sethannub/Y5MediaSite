---
import { reasons } from '../../config/content';
---
<section class="section why">
  <div class="container grid">
    <figure class="photo" data-reveal>
      <img src="/images/people/team.webp" alt="A marketing team working together around a laptop" width="1000" height="1250" loading="lazy" />
      <figcaption>
        <b>A Dubai team</b>
        <span>We plan, run and report on every campaign, and tell you plainly what’s working.</span>
      </figcaption>
    </figure>
    <div>
      <div class="kicker" data-reveal>Why Y5Media</div>
      <h2 data-reveal>Marketing built around <span class="accent">your goals.</span></h2>
      <ul class="list">
        {reasons.map((r, i) => (
          <li data-reveal data-reveal-delay={`${i * 0.06}s`}>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why { background: var(--white); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .photo { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; max-height: 640px; }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute; left: 20px; right: 20px; bottom: 20px; padding: 18px 20px; border-radius: var(--radius-md);
    display: grid; gap: 4px; color: var(--white);
    background: linear-gradient(180deg, rgba(11, 38, 27, .55), rgba(11, 38, 27, .75));
    border: 1px solid rgba(255, 255, 255, .2); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18);
    backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }
  figcaption b { font-family: var(--font-display); font-size: 20px; font-weight: 600; }
  figcaption span { font-size: 14.5px; color: rgba(255, 255, 255, .88); }
  h2 { margin-bottom: 24px; }
  .list { list-style: none; display: grid; }
  .list li { padding: 18px 0; border-top: 1px solid var(--gray-200); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 16px; }
  .list h3 { font-size: 20px; }
  .list p { color: var(--gray-500); font-size: 15.5px; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .photo { aspect-ratio: 4 / 3; }
    .list li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
