---
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---
<a class:list={['logo', tone]} href="/" aria-label="Y5Media home">
  <img src="/images/brand/logomark.svg" alt="" width="96" height="44" />
  <span aria-hidden="true">Media</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 6px; }
  img { height: 34px; width: auto; }
  span {
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-display); font-weight: 700; font-size: 10px; letter-spacing: .14em;
    text-transform: uppercase; line-height: 1;
  }
  .dark span { color: var(--white); }
  .light span { color: var(--ink); }
</style>
