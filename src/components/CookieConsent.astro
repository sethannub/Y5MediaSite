---
import { site } from '../config/site';
// Cookie consent banner. Shown until the visitor decides; reopened from the
// footer's "Cookie settings" button (any element with [data-cookie-settings]).
// Reject is exactly as prominent as Accept.
---
<section class="consent on-dark" data-consent data-ga4={site.analytics.ga4Id} aria-labelledby="consent-title" hidden>
  <div class="main" data-view="main">
    <h2 id="consent-title">Cookies on this site</h2>
    <p>
      We use necessary storage to make the site work. With your permission we’d also use Google
      Analytics cookies to understand how the site is used. You can change your mind any time from
      “Cookie settings” in the footer. <a href="/privacy">Privacy Policy</a>
    </p>
    <div class="actions">
      <button class="btn btn-primary btn-sm" type="button" data-accept>Accept all</button>
      <button class="btn btn-ghost btn-sm" type="button" data-reject>Reject all</button>
      <button class="link" type="button" data-open-prefs aria-expanded="false" aria-controls="consent-prefs">Preferences</button>
    </div>
  </div>

  <div class="prefs" id="consent-prefs" data-view="prefs" hidden>
    <div class="row">
      <div>
        <h3>Necessary</h3>
        <p>Remembers your cookie choice and keeps the contact form safe from spam. Always on.</p>
      </div>
      <span class="chip chip-live">Always on</span>
    </div>
    <div class="row">
      <div>
        <h3 id="analytics-label">Analytics</h3>
        <p id="analytics-desc">Google Analytics: which pages are visited and how people find the site. No advertising.</p>
      </div>
      <label class="switch">
        <input type="checkbox" role="switch" data-analytics aria-labelledby="analytics-label" aria-describedby="analytics-desc" />
        <span class="track" aria-hidden="true"></span>
      </label>
    </div>
    <div class="actions">
      <button class="btn btn-primary btn-sm" type="button" data-save>Save choices</button>
      <button class="btn btn-ghost btn-sm" type="button" data-accept>Accept all</button>
      <button class="btn btn-ghost btn-sm" type="button" data-reject>Reject all</button>
    </div>
  </div>
</section>

<script>
  import { readConsent, saveConsent, loadGoogleAnalytics, clearAnalyticsCookies } from '../scripts/consent';

  const banner = document.querySelector<HTMLElement>('[data-consent]');
  if (banner) {
    const gaId = banner.dataset.ga4 ?? '';
    const prefs = banner.querySelector<HTMLElement>('[data-view="prefs"]')!;
    const openPrefs = banner.querySelector<HTMLButtonElement>('[data-open-prefs]')!;
    const toggle = banner.querySelector<HTMLInputElement>('[data-analytics]')!;
    let returnFocus: HTMLElement | null = null;

    // On phones the banner spans the bottom of the screen: publish its height
    // so the chat button can sit above it instead of underneath (--consent-offset).
    const syncOffset = () => {
      const lift = !banner.hidden && window.innerWidth < 720 ? banner.offsetHeight + 12 : 0;
      document.documentElement.style.setProperty('--consent-offset', `${lift}px`);
    };
    new ResizeObserver(syncOffset).observe(banner);
    new MutationObserver(syncOffset).observe(banner, { attributes: true, attributeFilter: ['hidden'] });
    window.addEventListener('resize', syncOffset);

    const apply = (analytics: boolean, wasGranted: boolean) => {
      if (analytics) loadGoogleAnalytics(gaId);
      else if (wasGranted) clearAnalyticsCookies();
    };

    const show = (withPrefs: boolean) => {
      toggle.checked = readConsent()?.analytics ?? false;
      prefs.hidden = !withPrefs;
      openPrefs.setAttribute('aria-expanded', String(withPrefs));
      banner.hidden = false;
    };

    const decide = (analytics: boolean) => {
      const was = readConsent()?.analytics ?? false;
      saveConsent(analytics);
      apply(analytics, was);
      banner.hidden = true;
      returnFocus?.focus();
      returnFocus = null;
    };

    banner.querySelectorAll('[data-accept]').forEach((b) => b.addEventListener('click', () => decide(true)));
    banner.querySelectorAll('[data-reject]').forEach((b) => b.addEventListener('click', () => decide(false)));
    banner.querySelector('[data-save]')!.addEventListener('click', () => decide(toggle.checked));
    openPrefs.addEventListener('click', () => {
      const open = prefs.hidden;
      prefs.hidden = !open;
      openPrefs.setAttribute('aria-expanded', String(open));
      if (open) toggle.focus();
    });

    // Footer "Cookie settings" reopens the banner with preferences expanded.
    document.querySelectorAll<HTMLElement>('[data-cookie-settings]').forEach((el) =>
      el.addEventListener('click', () => {
        returnFocus = el;
        show(true);
        toggle.focus();
      }),
    );

    banner.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && readConsent()) { banner.hidden = true; returnFocus?.focus(); }
    });

    const existing = readConsent();
    if (existing) apply(existing.analytics, false);
    else show(false);
  }
</script>

<style>
  .consent {
    position: fixed; left: var(--gutter); bottom: 20px; z-index: 60;
    width: min(440px, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100vh - 40px); overflow-y: auto;
    background: rgba(24, 24, 24, .94); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    color: var(--on-dark); border: 1px solid var(--glass-border); border-radius: var(--radius-md);
    padding: 22px; box-shadow: 0 30px 70px -20px rgba(0, 0, 0, .6);
    animation: consent-in .5s var(--ease-out) both;
  }
  .consent[hidden] { display: none; }
  @keyframes consent-in { from { opacity: 0; transform: translateY(16px); } }
  h2 { font-size: 18px; letter-spacing: -.01em; line-height: 1.3; }
  p { font-size: 14px; color: var(--on-dark-muted); margin-top: 8px; }
  p a { color: var(--lime); text-decoration: underline; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 16px; }
  /* A tool, not a call to action: no hover light (global.css) */
  .actions .btn::before { content: none; }
  .link {
    background: none; border: 0; color: var(--on-dark); font-weight: 600; font-size: 14px;
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 8px 6px;
  }
  .prefs { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--glass-border); }
  .prefs[hidden] { display: none; }
  /* With preferences open, the panel has its own buttons — don't show them twice */
  .consent:has(.prefs:not([hidden])) .main .actions { display: none; }
  .consent:has(.prefs:not([hidden])) .prefs { margin-top: 12px; }
  .row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 10px 0; }
  .row + .row { border-top: 1px solid var(--glass-border); }
  h3 { font-size: 15px; line-height: 1.3; }
  .row p { margin-top: 4px; font-size: 13px; }
  .switch { position: relative; flex: none; width: 46px; height: 26px; cursor: pointer; }
  .switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .track { position: absolute; inset: 0; border-radius: 99px; background: var(--gray-600); transition: background .2s; }
  .track::after {
    content: ''; position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--white); transition: transform .2s var(--ease-out);
  }
  .switch input:checked + .track { background: var(--green); }
  .switch input:checked + .track::after { transform: translateX(20px); }
  .switch input:focus-visible + .track { outline: 2px solid var(--lime); outline-offset: 3px; }
  @media (max-width: 520px) {
    .consent { left: 12px; right: 12px; bottom: 12px; width: auto; }
    .actions .btn { flex: 1 1 auto; }
  }
</style>
