---
import { venues } from '../../config/content';

interface Benefit { t: string; d: string }
interface Props {
  ind: {
    id: string; name: string; img: string; imgPos?: string; alt: string;
    title: string; accent: string; lede: string; venues: readonly string[];
    best: 'leads' | 'ads'; example: { project: string; meta: string }; leadsNote: string;
    leads: readonly Benefit[]; ads: readonly Benefit[]; leadsCta: string; adsCta: string;
  };
  flip?: boolean;
}
const { ind, flip = false } = Astro.props;
const venueImg = (name: string) => venues.find((v) => v.name === name)?.img;
---
<section class:list={['ind', { flip }]} id={ind.id}>
  <div class="container">
    <div class="top">
      <div class="media" data-reveal>
        <img src={ind.img} alt={ind.alt} width="1000" height="750" loading="lazy" style={ind.imgPos ? `object-position:${ind.imgPos}` : undefined} />
        <div class="lead" aria-label="Example lead">
          <div class="row"><span class="pill">AVAILABLE</span><span class="ex">Example</span></div>
          <div class="proj">{ind.example.project}</div>
          <div class="blur" aria-hidden="true"></div>
          <div class="meta">{ind.example.meta}</div>
          <span class="unlock">Unlock · AED 250</span>
        </div>
      </div>
      <div class="text">
        <div class="kicker" data-reveal>{ind.name}</div>
        <h2 data-reveal>{ind.title} <span class="accent">{ind.accent}</span></h2>
        <p class="lede" data-reveal>{ind.lede}</p>
        <div class="venues" data-reveal>
          <span>Where your ads run best</span>
          <ul>
            {ind.venues.map((v) => (
              <li>{venueImg(v) && <img src={venueImg(v)} alt="" width="28" height="28" loading="lazy" />}{v}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="cards">
      <article class:list={['card leads forest on-dark', { primary: ind.best === 'leads' }]} data-reveal>
        <header><h3>Y5Leads <small>{ind.leadsNote}</small></h3>{ind.best === 'leads' && <span class="badge">Best fit</span>}</header>
        <ul>
          {ind.leads.map((b) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg><b>{b.t}</b><span>{b.d}</span></li>
          ))}
        </ul>
        <a class="go" href="/contact?interest=y5leads">{ind.leadsCta} <span aria-hidden="true">→</span></a>
      </article>
      <article class:list={['card ads', { primary: ind.best === 'ads' }]} data-reveal data-reveal-delay=".08s">
        <header><h3>Y5Ads <small>WiFi advertising</small></h3>{ind.best === 'ads' && <span class="badge">Best fit</span>}</header>
        <ul>
          {ind.ads.map((b) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg><b>{b.t}</b><span>{b.d}</span></li>
          ))}
        </ul>
        <a class="go" href="/contact?interest=y5ads">{ind.adsCta} <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<style>
  .ind { padding-block: var(--section); border-bottom: 1px solid var(--gray-200); scroll-margin-top: 130px; }
  .top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .flip .media { order: 2; }
  .media { position: relative; }
  .media > img { width: 100%; height: auto; aspect-ratio: 4 / 3.3; object-fit: cover; border-radius: var(--radius-lg); }
  .lead {
    position: absolute; left: clamp(12px, 3vw, 28px); bottom: clamp(-28px, -2vw, -12px); width: min(330px, 84%);
    background: var(--white); border-radius: var(--radius-md); padding: 18px 20px; display: grid; gap: 10px;
    box-shadow: 0 1px 2px rgba(20, 33, 26, .06), 0 24px 50px -16px rgba(20, 33, 26, .35);
  }
  .flip .lead { left: auto; right: clamp(12px, 3vw, 28px); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pill { font-size: 11px; font-weight: 700; letter-spacing: .08em; padding: 5px 10px; border-radius: var(--radius-pill); background: #DBEAFE; color: #1D4ED8; }
  .ex { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gray-500); }
  .proj { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: -.01em; }
  .meta { font-size: 14px; color: var(--gray-600); }
  .blur { height: 14px; width: 62%; border-radius: 6px; background: var(--gray-200); }
  .unlock { justify-self: start; font-size: 13px; font-weight: 600; background: var(--green); color: #0B1A10; border-radius: var(--radius-pill); padding: 8px 14px; }
  .text .lede { margin-top: 18px; font-size: var(--text-lg); color: var(--gray-600); max-width: 58ch; }
  .venues { margin-top: 26px; display: grid; gap: 10px; }
  .venues > span { font-size: 13px; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: .06em; }
  .venues ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .venues li { display: flex; align-items: center; gap: 8px; background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-pill); padding: 5px 14px 5px 5px; font-size: 14px; font-weight: 500; }
  .venues li img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .cards { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { border-radius: var(--radius-lg); padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 22px; }
  .card.ads { background: var(--white); border: 1px solid var(--gray-200); }
  .card.primary { box-shadow: 0 0 0 2px var(--green); }
  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 26px; display: flex; align-items: baseline; gap: 10px; }
  h3 small { font-family: var(--font-body); font-size: 14px; font-weight: 500; letter-spacing: 0; color: var(--gray-500); }
  .leads h3 small { color: var(--on-dark-faint); }
  .badge { font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: var(--radius-pill); background: var(--lime); color: #0B1A10; }
  .card ul { list-style: none; display: grid; gap: 18px; }
  .card li { display: grid; grid-template-columns: 28px 1fr; gap: 4px 14px; }
  .card li svg { grid-row: span 2; width: 28px; height: 28px; padding: 5px; border-radius: 50%; background: var(--green-tint); color: var(--green-ink); fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .leads li svg { background: rgba(166, 231, 42, .14); color: var(--lime); }
  .card li b { font-weight: 600; font-size: 16px; }
  .card li span { font-size: 15px; color: var(--gray-600); }
  .leads li span { color: var(--on-dark-muted); }
  .go { margin-top: auto; font-weight: 600; font-size: 15px; display: inline-flex; gap: 8px; color: var(--green-ink); }
  .leads .go { color: var(--lime); }
  .go span { transition: transform .2s var(--ease-out); }
  .go:hover span { transform: translateX(3px); }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; }
    .flip .media { order: 0; }
    .text { margin-top: 24px; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
