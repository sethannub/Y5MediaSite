---
// Two small floating controls on every page: Back (bottom left) returns to the
// previous page, or home when there is none on this site; Back to top
// (bottom right) appears once the page has been scrolled.
const isHome = ['/', '/index', '/index.html'].includes(Astro.url.pathname);
---
<div class="site-controls">
  {!isHome && (
    <button type="button" class="sc-btn sc-back" data-sc-back aria-label="Back to the previous page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      <span>Back</span>
    </button>
  )}
  <button type="button" class="sc-btn sc-top" data-sc-top aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
  </button>
</div>

<script>
  const top = document.querySelector<HTMLButtonElement>('[data-sc-top]');
  const back = document.querySelector<HTMLButtonElement>('[data-sc-back]');
  const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  if (top) {
    const toggle = () => { top.hidden = window.scrollY < 600; };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    top.addEventListener('click', () => window.scrollTo({ top: 0, behavior: smooth as ScrollBehavior }));
  }

  back?.addEventListener('click', () => {
    const cameFromHere = document.referrer && new URL(document.referrer).origin === location.origin;
    if (cameFromHere && history.length > 1) history.back();
    else location.href = (document.querySelector<HTMLAnchorElement>('.nav .logo')?.href) || '/';
  });
</script>

<style>
  .site-controls { position: fixed; inset: auto 0 0 0; z-index: 45; pointer-events: none; }
  .sc-btn {
    pointer-events: auto; position: absolute; bottom: 20px; display: inline-flex; align-items: center; gap: 8px;
    height: 48px; border-radius: 999px; cursor: pointer; font: 600 14px var(--font-body); color: var(--white);
    background: rgba(11, 38, 27, .82); border: 1px solid rgba(255, 255, 255, .18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14), 0 14px 30px -12px rgba(0, 0, 0, .55);
    backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3);
    transition: background .25s, color .25s, transform .3s cubic-bezier(.16, 1, .3, 1);
  }
  .sc-btn:hover { background: #C4F25A; color: #0B1A10; transform: translateY(-2px); }
  .sc-btn:focus-visible { outline: 2px solid #C4F25A; outline-offset: 3px; }
  .sc-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sc-back { left: 20px; padding: 0 18px 0 14px; }
  .sc-top { right: 20px; width: 48px; justify-content: center; }
  .sc-top[hidden] { display: none; }
  @media (max-width: 600px) { .sc-btn { bottom: 14px; height: 44px; } .sc-back { left: 14px; } .sc-top { right: 14px; width: 44px; } .sc-back span { display: none; } .sc-back { padding: 0 13px; } }
</style>
