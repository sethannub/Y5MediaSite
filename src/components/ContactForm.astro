---
import { site } from '../config/site';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const interests = [
  { value: 'wifi', label: 'WiFi Marketing' },
  { value: 'y5leads', label: 'Y5Leads (property leads)' },
  { value: 'both', label: 'Both' },
  { value: 'other', label: 'Something else' },
];
---
<div class="form-card" data-contact>
  <form class="form" novalidate data-form>
    <p class="intro">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

    <div class="error-summary" role="alert" tabindex="-1" data-summary hidden>
      <b>Please check the highlighted fields.</b>
      <ul data-summary-list></ul>
    </div>

    <div class="grid">
      <div class="field">
        <label for="cf-name">Full name <span aria-hidden="true">*</span></label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-err" />
        <p class="err" id="cf-name-err" data-err></p>
      </div>
      <div class="field">
        <label for="cf-email">Email <span aria-hidden="true">*</span></label>
        <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" aria-describedby="cf-email-err" />
        <p class="err" id="cf-email-err" data-err></p>
      </div>
      <div class="field">
        <label for="cf-phone">Phone <span class="opt">(optional)</span></label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
      </div>
      <div class="field">
        <label for="cf-company">Company <span class="opt">(optional)</span></label>
        <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" />
      </div>

      <fieldset class="field full">
        <legend>What are you interested in? <span aria-hidden="true">*</span></legend>
        <div class="choices">
          {interests.map((it, i) => (
            <label class="choice">
              <input type="radio" name="interest" value={it.value} id={`cf-interest-${it.value}`} required checked={i === 3} />
              <span>{it.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field full">
        <label for="cf-message">How can we help? <span aria-hidden="true">*</span></label>
        <textarea id="cf-message" name="message" rows="5" maxlength="3000" required aria-describedby="cf-message-err"></textarea>
        <p class="err" id="cf-message-err" data-err></p>
      </div>
    </div>

    <div class="hp" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label class="check">
        <input id="cf-consent" name="consent" type="checkbox" required aria-describedby="cf-consent-err" />
        <span>I agree to be contacted about this enquiry. See our <a href="/privacy">Privacy Policy</a>. <span aria-hidden="true">*</span></span>
      </label>
      <p class="err" id="cf-consent-err" data-err></p>
    </div>

    {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>}

    <div class="submit-row">
      <button class="btn btn-primary" type="submit" data-submit><span data-label>Send enquiry</span></button>
      <p class="fail" role="alert" data-fail hidden>
        Sorry, we couldn’t send that just now. Please try again, or email us at {site.contact.email}.
      </p>
    </div>
  </form>

  <div class="success" data-success hidden tabindex="-1" aria-live="polite">
    <h2>Thanks, we’ve got it.</h2>
    <p>We’ll reply to <b data-success-email></b> within one working day.</p>
    <a class="btn btn-outline" href="/">Back to home</a>
  </div>
</div>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const root = document.querySelector<HTMLElement>('[data-contact]');
  const form = root?.querySelector<HTMLFormElement>('[data-form]');

  if (root && form) {
    const pre = new URLSearchParams(location.search).get('interest');
    const preRadio = pre ? form.querySelector<HTMLInputElement>(`input[name="interest"][value="${CSS.escape(pre)}"]`) : null;
    if (preRadio) preRadio.checked = true;

    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const list = root.querySelector<HTMLElement>('[data-summary-list]')!;
    const fail = root.querySelector<HTMLElement>('[data-fail]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = root.querySelector<HTMLElement>('[data-label]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const setErr = (name: string, msg: string) => {
      const el = field(name);
      const err = document.getElementById(`cf-${name}-err`);
      if (err) err.textContent = msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    const check = () => {
      const errors: [string, string][] = [];
      if (!field('name').value.trim()) errors.push(['name', 'Enter your name.']);
      if (!EMAIL_RE.test(field('email').value.trim())) errors.push(['email', 'Enter a valid email address.']);
      if (!field('message').value.trim()) errors.push(['message', 'Tell us a little about what you need.']);
      if (!field('consent').checked) errors.push(['consent', 'Tick the box so we can reply to you.']);
      ['name', 'email', 'message', 'consent'].forEach((n) => setErr(n, errors.find((e) => e[0] === n)?.[1] ?? ''));
      list.innerHTML = '';
      errors.forEach(([n, msg]) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#cf-${n}`; a.textContent = msg;
        li.appendChild(a); list.appendChild(li);
      });
      summary.hidden = errors.length === 0;
      if (errors.length) summary.focus();
      return errors.length === 0;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fail.hidden = true;
      if (!check()) return;
      const data = new FormData(form);
      const payload = {
        name: data.get('name'), email: data.get('email'), phone: data.get('phone'), company: data.get('company'),
        interest: data.get('interest'), message: data.get('message'), website: data.get('website'),
        consent: field('consent').checked, turnstile: data.get('cf-turnstile-response') ?? '',
      };
      submit.disabled = true; label.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const out = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !out.ok) throw new Error(out.error || 'failed');
        form.hidden = true;
        root.querySelector('[data-success-email]')!.textContent = String(payload.email);
        success.hidden = false; success.focus();
      } catch {
        fail.hidden = false;
      } finally {
        submit.disabled = false; label.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .form-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: clamp(24px, 4vw, 44px); }
  .form { display: grid; gap: 22px; }
  .intro { font-size: 14px; color: var(--gray-500); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
  .field { display: grid; gap: 6px; min-width: 0; border: 0; }
  .full { grid-column: 1 / -1; }
  label, legend { font-size: 14px; font-weight: 600; }
  .opt { font-weight: 400; color: var(--gray-500); }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    width: 100%; font: inherit; font-size: 16px; color: var(--ink);
    padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--gray-300); background: var(--white);
    transition: border-color .2s, box-shadow .2s;
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--green-ink); box-shadow: 0 0 0 3px rgba(117, 182, 48, .25); }
  [aria-invalid='true'] { border-color: var(--red) !important; }
  .err { font-size: 13px; color: var(--red); min-height: 0; }
  .err:empty { display: none; }
  .choices { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .choice { position: relative; font-weight: 500; }
  .choice input { position: absolute; opacity: 0; }
  .choice span { display: inline-block; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--gray-300); cursor: pointer; transition: all .2s; }
  .choice input:checked + span { background: var(--forest); color: var(--white); border-color: var(--forest); }
  .choice input:focus-visible + span { outline: 2px solid var(--green-ink); outline-offset: 2px; }
  .check { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; font-size: 14px; }
  .check input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--green-ink); flex: none; }
  .check a { color: var(--green-ink); text-decoration: underline; }
  .hp { position: absolute; left: -9999px; }
  .error-summary { border: 1px solid var(--red); border-radius: var(--radius-sm); padding: 14px 16px; background: #FEF2F2; font-size: 14px; }
  .error-summary ul { margin: 6px 0 0 18px; }
  .error-summary a { color: var(--red); text-decoration: underline; }
  .submit-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .fail { font-size: 14px; color: var(--red); }
  .success { display: grid; gap: 14px; justify-items: start; }
  .success p { color: var(--gray-500); }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
