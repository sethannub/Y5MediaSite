---
const icons = {
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.3a9.5 9.5 0 0 1 13 0M8.6 15.5a5 5 0 0 1 6.8 0"/><circle cx="12" cy="19" r="1.3" fill="currentColor"/>',
  image: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.6"/><path d="M21 16l-5-5-8 8"/>',
  user: '<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  funnel: '<path d="M3 5h18l-7 8v6l-4 2v-8z"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  click: '<path d="M9 9l11 4-5 1.5L13.5 20z"/><path d="M5 3.5l1 2.2M2.8 7.7l2.3.6M10.6 2.9l-.6 2.3"/>',
};
const stats = [
  { icon: 'wifi', t: '50K hotspots', d: 'Public and private WiFi hotspots in hotels, cafés, shopping malls and public places.' },
  { icon: 'image', t: '50 million+ impressions', d: 'Build brand awareness and share promotions with every nationality, in every corner of the country.' },
  { icon: 'user', t: '100% user attention', d: 'People pay attention to your product or service in a memorable, interactive format.' },
  { icon: 'funnel', t: '40% to 60% conversion rate', d: 'High conversion on ad clicks, with only one advertiser in focus for the whole WiFi login.' },
  { icon: 'eye', t: 'CPM from $4', d: 'Paying per thousand impressions grows your brand’s reach and drives meaningful engagement.' },
  { icon: 'click', t: 'CPC from $0.02', d: 'Pay per click with measurable ROI. Drive sales and keep your brand in front of potential customers.' },
] as const;
const svg = (k: keyof typeof icons) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${icons[k]}</svg>`;
---
<section class="section ads-network" id="network">
  <img class="bg" src="/images/y5ads/laptop-phone.webp" alt="" width="1647" height="2560" loading="lazy" />
  <div class="container">
    <div class="head">
      <h2 data-reveal><span class="accent">Largest WiFi</span> network in the UAE.</h2>
      <p class="lede" data-reveal>
        Y5Ads shows your ad on WiFi networks in 500+ locations across the UAE. Internet access opens only after the
        visitor has seen your offer.
      </p>
    </div>
    <ul class="stats">
      {stats.map((s, i) => (
        <li data-reveal data-reveal-delay={`${(i % 3) * 0.08}s`}>
          <span class="ico" set:html={svg(s.icon)} />
          <div><h3>{s.t}</h3><p>{s.d}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ads-network { position: relative; overflow: hidden; background: #fff; }
  .bg { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 100%; height: auto; max-width: none; pointer-events: none; }
  .container { position: relative; z-index: 1; }
  .head { text-align: center; display: grid; justify-items: center; gap: 18px; margin: 0 auto 56px; max-width: 720px; }
  .head .lede { margin-inline: auto; }
  .stats { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 36px; max-width: 1000px; margin: 0 auto; }
  .stats li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; align-items: start; }
  .ico { width: 48px; height: 48px; color: var(--green); }
  .ico :global(svg) { width: 48px; height: 48px; }
  .stats h3 { font-size: 18px; margin-bottom: 6px; }
  .stats p { color: var(--gray-500); font-size: 14.5px; }
  @media (max-width: 1100px) { .bg { opacity: .35; } }
  @media (max-width: 900px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } }
</style>
