---
interface Props {
  pricing?: boolean;
}
const { pricing = true } = Astro.props;
const stats = [
  { b: '50K', t: 'Hotspots', d: 'Public and private WiFi hotspots in hotels, cafés, shopping malls and public places.' },
  { b: '50M+', t: 'Impressions', d: 'Build brand awareness and share promotions with every nationality, in every corner of the country.' },
  { b: '100%', t: 'User attention', d: 'People pay attention to your product or service in a memorable, interactive format.' },
  { b: '40–60%', t: 'Conversion rate', d: 'High conversion on ad clicks, with only one advertiser in focus for the whole login.' },
];
---
<section class="section ads-network on-dark" id="network">
  <img class="map" src="/images/y5ads/uae-map.webp" alt="" width="1920" height="1000" loading="lazy" />
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker" data-reveal>Largest WiFi network in the UAE</div>
        <h2 data-reveal>500+ locations. <span class="accent">One login screen.</span></h2>
      </div>
      <p class="lede" data-reveal>
        Y5Ads shows your ad on WiFi networks in 500+ locations across the UAE. Internet access opens only after the
        visitor has seen your offer.
      </p>
    </div>
    <ul class="stats">
      {stats.map((s, i) => (
        <li data-reveal data-reveal-delay={`${i * 0.08}s`}>
          <b>{s.b}</b>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ul>
    {pricing && (
      <ul class="rates">
        <li data-reveal>
          <small>CPM from</small><b>$4</b>
          <p>Cost per thousand impressions grows your brand’s reach and drives meaningful engagement with your audience.</p>
        </li>
        <li data-reveal data-reveal-delay=".08s">
          <small>CPC from</small><b>$0.02</b>
          <p>Pay per click with measurable ROI. Drive sales and keep your brand in front of potential customers.</p>
        </li>
      </ul>
    )}
  </div>
</section>

<style>
  .ads-network { position: relative; overflow: hidden; background: #2F7A12; color: var(--on-dark); }
  .map { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 80% 50%; }
  .ads-network::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(11, 38, 27, .55), rgba(11, 38, 27, .82)); }
  .container { position: relative; z-index: 2; }
  .stats { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .stats li, .rates li {
    padding: 26px; border-radius: var(--radius-md); display: grid; gap: 8px; align-content: start;
    background: var(--glass); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
  .stats b { font-family: var(--font-display); font-size: clamp(34px, 3.2vw, 48px); font-weight: 600; letter-spacing: -.03em; line-height: 1; color: var(--lime); }
  .stats h3 { font-size: 19px; }
  .stats p, .rates p { color: var(--on-dark-muted); font-size: 15px; }
  .rates { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  .rates li { grid-template-columns: auto 1fr; column-gap: 20px; align-items: center; }
  .rates small { grid-column: 1; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--lime); }
  .rates b { grid-column: 1; font-family: var(--font-display); font-size: 44px; font-weight: 600; line-height: 1; }
  .rates p { grid-column: 2; grid-row: 1 / span 2; }
  @media (max-width: 1000px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .stats, .rates { grid-template-columns: 1fr; } }
</style>
