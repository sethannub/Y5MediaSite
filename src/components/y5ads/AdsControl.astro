---
const icons = {
  tag: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>',
  anchor: '<circle cx="12" cy="5" r="2.2"/><path d="M12 7.2V21M7 11h10M4 14a8 8 0 0 0 16 0"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/>',
};
const items = [
  { icon: 'tag', t: 'Pricing', d: 'Set your daily budget and pay only for the impressions you receive.' },
  { icon: 'anchor', t: 'Targeting', d: 'As detailed as location, operating system, browser and traffic source.' },
  { icon: 'gear', t: 'Campaign management', d: 'Track, analyse and optimise your campaigns straight from the dashboard.' },
] as const;
const svg = (k: keyof typeof icons) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${icons[k]}</svg>`;
---
<section class="section ads-control">
  <img class="bg" src="/images/y5ads/watermark.webp" alt="" width="1920" height="617" loading="lazy" />
  <div class="container">
    <h2 data-reveal>Get <span class="accent">100% control</span> over your ad campaigns.</h2>
    <ul class="items">
      {items.map((it, i) => (
        <li data-reveal data-reveal-delay={`${i * 0.08}s`}>
          <span class="ico" set:html={svg(it.icon)} />
          <div><h3>{it.t}</h3><p>{it.d}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ads-control { position: relative; overflow: hidden; background: #fff; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .container { position: relative; z-index: 1; }
  h2 { text-align: center; margin: 0 auto 48px; max-width: 18ch; }
  .items { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; max-width: 1000px; margin: 0 auto; }
  .items li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; align-items: start; }
  .ico { width: 48px; height: 48px; color: var(--green); }
  .ico :global(svg) { width: 48px; height: 48px; }
  .items h3 { font-size: 19px; margin-bottom: 6px; }
  .items p { color: var(--gray-500); font-size: 15px; }
  @media (max-width: 800px) { .items { grid-template-columns: 1fr; } }
</style>
