---
---
<section class="section ads-setup on-dark">
  <img class="bg" src="/images/y5ads/campaign-setup.webp" alt="" width="1920" height="1500" loading="lazy" />
  <div class="container">
    <div class="copy">
      <h2 data-reveal>Set up an ad campaign <span class="strong">in 2 clicks.</span></h2>
      <p data-reveal>In your Y5Ads account you can create a full ad campaign without wasting time.</p>
      <p data-reveal>
        Target your audience with banner, video and SMS marketing, and run WiFi ads for the dates you choose in the
        locations you pick. Any manager in your company can do it.
      </p>
      <a class="btn" href="/contact?interest=y5ads" data-reveal>Start your campaign <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .ads-setup { position: relative; overflow: hidden; background: #5FBF0F; color: #fff; min-height: 760px; display: flex; align-items: center; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 6%; }
  .container { position: relative; z-index: 1; width: 100%; }
  .copy { max-width: 520px; display: grid; gap: 18px; justify-items: start; }
  h2 { font-weight: 500; }
  .strong { font-weight: 700; }
  .copy p { font-size: var(--text-lg); color: rgba(255, 255, 255, .92); }
  .btn { margin-top: 8px; background: #fff; color: #0B261B; }
  @media (max-width: 1000px) {
    .ads-setup { min-height: 0; }
    .bg { opacity: .3; }
  }
</style>
