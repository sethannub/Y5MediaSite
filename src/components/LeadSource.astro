---
// Where Y5Leads leads come from: Y5Media's own 360° marketing platform and the
// audience it has built across every industry, not third-party ad platforms.
const icons = {
  platform: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a13 13 0 0 1 0 17M12 3.5a13 13 0 0 0 0 17M3.5 12h17"/>',
  data: '<ellipse cx="12" cy="6" rx="7" ry="2.8"/><path d="M5 6v6c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8V6M5 12v6c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-6"/>',
  match: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
  inbox: '<path d="M4 13l2.5-7.5h11L20 13v5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18z"/><path d="M4 13h4.5l1.5 2.5h4l1.5-2.5H20"/>',
};
const svg = (k: keyof typeof icons) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${icons[k]}</svg>`;

const flow = [
  { icon: 'platform', k: 'Source', t: 'Y5Media 360° platform', d: 'Our own marketing platform, run by our team in Dubai.' },
  { icon: 'data', k: 'Data', t: 'Real buyers in every industry', d: 'Real estate, automotive, retail and more.' },
  { icon: 'match', k: 'Match', t: 'Smart Profile Matching', d: 'Only verified leads with real interest in your offer.' },
  { icon: 'inbox', k: 'Delivered', t: 'Your Y5Leads list', d: 'Ready to unlock, call and follow up.' },
] as const;
---
<section class="section source" id="lead-source">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker" data-reveal>Where our leads come from</div>
        <h2 data-reveal>Y5Media’s 360° marketing platform. <span class="accent">No Google. No Meta. No borrowed ads.</span></h2>
      </div>
      <p class="lede" data-reveal>
        With the 360° platform you reach buyers who are already interested. Our audience has grown over years in the
        UAE market, so your campaigns start with people who are ready to engage.
      </p>
    </div>

    <div class="pipeline" data-reveal>
      <img class="bg" src="/images/hero/y5leads.webp" alt="" width="1800" height="1125" loading="lazy" />
      <div class="track" aria-hidden="true"><span class="pulse"></span></div>
      <ol class="nodes">
        {flow.map((f, i) => (
          <li style={`--i:${i}`}>
            <span class:list={['icon', { first: i === 0 }]} set:html={svg(f.icon)} />
            <span class="step">{f.k}</span>
            <b>{f.t}</b>
            <small>{f.d}</small>
          </li>
        ))}
      </ol>
    </div>

  </div>
</section>

<style>
  .source { background: var(--paper); }
  .pipeline {
    position: relative; overflow: hidden; border-radius: var(--radius-lg); padding: clamp(28px, 4vw, 52px) clamp(20px, 3vw, 40px);
    background: var(--forest-glow), var(--forest); color: var(--on-dark);
  }
  .bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .22; mix-blend-mode: luminosity;
    -webkit-mask-image: linear-gradient(90deg, transparent 10%, #000 70%); mask-image: linear-gradient(90deg, transparent 10%, #000 70%);
  }
  .nodes { position: relative; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .nodes li { display: grid; gap: 6px; align-content: start; justify-items: start; }
  .icon {
    width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; color: var(--lime); margin-bottom: 10px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .05));
    border: 1px solid var(--glass-border); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .16), 0 14px 30px -14px rgba(0, 0, 0, .6);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .icon :global(svg) { width: 28px; height: 28px; }
  .icon.first { background: var(--lime); color: #0B1A10; border-color: transparent; }
  .step { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--lime); }
  .nodes b { font-family: var(--font-display); font-weight: 600; font-size: 20px; line-height: 1.2; }
  .nodes small { font-size: 14.5px; color: var(--on-dark-muted); max-width: 26ch; }

  /* The line joining the four icons, with a light travelling along it */
  .track { position: absolute; left: calc(clamp(20px, 3vw, 40px) + 32px); right: calc(clamp(20px, 3vw, 40px) + 25% - 20px); top: calc(clamp(28px, 4vw, 52px) + 32px); height: 2px; background: rgba(166, 231, 42, .25); }
  .pulse { position: absolute; top: -3px; left: 0; width: 60px; height: 8px; border-radius: 999px; background: linear-gradient(90deg, transparent, var(--lime), transparent); filter: blur(1px); animation: ls-travel 3.2s cubic-bezier(.45, 0, .55, 1) infinite; }
  @keyframes ls-travel { from { left: -60px; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } to { left: 100%; opacity: 0; } }
  html.motion .pipeline.is-in .nodes li { animation: ls-node-in .7s var(--ease-out) both; animation-delay: calc(var(--i) * .14s + .15s); }
  @keyframes ls-node-in { from { opacity: 0; transform: translateY(16px); } }


  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; display: none; } }
  @media (max-width: 960px) {
    .nodes { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 32px; }
    .track { display: none; }
  }
  @media (max-width: 520px) { .nodes { grid-template-columns: 1fr; } }
</style>
