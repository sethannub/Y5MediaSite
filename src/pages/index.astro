---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSplit from '../components/home/HomeSplit.astro';
import ClientStrip from '../components/home/ClientStrip.astro';
import Journey from '../components/Journey.astro';
import WifiPhone from '../components/mocks/WifiPhone.astro';
import LeadsApp from '../components/mocks/LeadsApp.astro';
import Venues from '../components/home/Venues.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import LeadPricing from '../components/LeadPricing.astro';
import Industries from '../components/home/Industries.astro';
import Why from '../components/home/Why.astro';
import CtaBand from '../components/CtaBand.astro';
import { wifiSteps, leadSteps } from '../config/content';
import { site } from '../config/site';
const leadsLogin = site.logins.find((l) => l.label === 'Y5Leads')!.href;

const leadFeatures = [
  { title: 'Matched to your projects', text: 'Leads that fit your projects’ area and budget are delivered to your dashboard.' },
  { title: 'Unlock only what you want', text: 'New leads arrive blurred. Pay for the ones worth calling, nothing else.' },
  { title: 'Bad lead? Get credits back', text: 'Report a wrong lead and our team refunds your credits once it’s approved.' },
];
---
<BaseLayout>
  <HomeSplit />

  <div id="product-wifi" data-product="wifi" hidden>
    <Journey
      id="wifi-journey"
      kicker="How WiFi Marketing works"
      title="From a WiFi login"
      accent="to your website."
      text="Four steps, from the moment someone connects to the numbers in your report."
      steps={wifiSteps}
      tone="light"
      cta={{ label: 'Plan a campaign', href: '/contact?interest=wifi' }}
      secondary={{ label: 'Full WiFi Marketing page', href: '/wifi-marketing' }}
    >
      <WifiPhone slot="stage" />
    </Journey>
    <Venues cta={{ label: 'Plan a campaign', href: '/contact?interest=wifi' }} />
  </div>

  <div id="product-y5leads" data-product="y5leads" hidden>
    <Journey
      id="lead-journey"
      kicker="How Y5Leads works"
      title="From interest to an enquiry"
      accent="your team can call."
      text="Buyers looking for property are matched to your projects and land in your Y5Leads dashboard."
      steps={leadSteps}
      tone="light"
      stageKind="app"
      cta={{ label: 'Get started', href: '/contact?interest=y5leads' }}
      secondary={{ label: 'Log in to Y5Leads', href: leadsLogin }}
    >
      <LeadsApp slot="stage" />
    </Journey>
    <FeatureGrid kicker="Inside Y5Leads" title="Pay for leads," accent="not for noise." items={leadFeatures} />
    <LeadPricing more />
  </div>

  <ClientStrip />
  <Industries />
  <Why />
  <CtaBand />
</BaseLayout>
