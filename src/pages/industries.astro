  .bar { position: absolute; left: 12px; right: 12px; bottom: 5px; height: 2px; border-radius: 1px; background: rgba(196, 242, 90, .9); transform: scaleX(0); transform-origin: left; }
  .pick[aria-selected='true'] .bar { transform: scaleX(1); }
  .is-auto .pick[aria-selected='true'] .bar { transform: scaleX(0); animation: ix-fill 7s linear forwards; }
  .is-paused .pick[aria-selected='true'] .bar, .is-offscreen .pick[aria-selected='true'] .bar { animation-play-state: paused; }
  @keyframes ix-fill { to { transform: scaleX(1); } }
  .panel-foot { display: flex; align-items: center; justify-content: space-between; padding: 12px 10px 4px; border-top: 1px solid var(--gray-100); }
  .count { font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--gray-500); }
  .count b { color: var(--ink); }
  .arrows { display: flex; gap: 8px; }
  .arrow { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--gray-200); background: var(--white); color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: background .2s; }
  .arrow:hover { background: var(--gray-100); }
  .arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .stage { position: relative; display: grid; min-height: 680px; border-radius: 26px; overflow: hidden; background: #03140D; color: var(--white); box-shadow: 0 50px 90px -40px rgba(11, 38, 27, .7); }
  .stage-bg { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1); transition: opacity 1.1s ease, transform 7s linear; }
  .stage-bg[data-active] { opacity: 1; transform: scale(1.06); }
  .shade { grid-area: 1 / 1; z-index: 1; background: linear-gradient(180deg, rgba(3, 20, 13, .35) 0%, rgba(3, 20, 13, .55) 35%, rgba(3, 20, 13, .94) 72%); }
  .slide { grid-area: 1 / 1; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end; gap: 26px; padding: 40px 44px 44px; }
  .slide[hidden] { display: none; }
  .slide-copy, .cards { animation: ix-in .8s var(--ease-out) both; }
  .cards { animation-delay: .12s; }
  @keyframes ix-in { from { opacity: 0; transform: translateY(28px); } }
  .slide-copy { display: grid; gap: 14px; max-width: 640px; }
  .slide-kicker { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lime); }
  .slide h3 { font-size: clamp(30px, 3.2vw, 44px); line-height: 1.04; letter-spacing: -.035em; }
  .slide p { font-size: 16px; line-height: 1.6; color: #C9D8CF; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .svc-card { display: grid; gap: 10px; align-content: start; padding: 18px; border-radius: 18px; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 18px 40px -24px rgba(0, 0, 0, .6); transition: transform .3s var(--ease-out); }
  .svc-card:hover { transform: translateY(-4px); }
