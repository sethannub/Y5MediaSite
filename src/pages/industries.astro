  .ax-video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5, 20, 12, 0) 45%, rgba(5, 20, 12, .7)); }
  .ax-wifi { position: absolute; z-index: 1; left: 24px; right: 24px; bottom: 24px; display: grid; gap: 10px; padding: 16px; border-radius: 18px; background: rgba(255, 255, 255, .95); box-shadow: 0 24px 50px -20px rgba(0, 0, 0, .6); }
