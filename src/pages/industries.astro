---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

type Fit = 1 | 2 | 3;

const services = [
  { key: 'leads', name: 'Y5Leads', href: '/y5leads', exLabel: 'Example lead' },
  { key: 'camp', name: 'Y5Campaigns', href: '/y5campaigns', exLabel: 'Example subject' },
  { key: 'ads', name: 'Y5Ads', href: '/y5ads', exLabel: 'Where it shows' },
] as const;

const FIT: Record<Fit, string> = { 3: 'Best fit', 2: 'Strong fit', 1: 'Also works' };

// fit, ex and uses are in service order: Y5Leads, Y5Campaigns, Y5Ads.
const industries: {
  name: string; img: string; pos?: string; title: string; decide: string;
  fit: [Fit, Fit, Fit]; ex: [string, string, string]; uses: [string[], string[], string[]];
}[] = [
  { name: 'Real Estate', img: '/images/industries/real-estate.webp', title: 'Buyers and investors, ready for a viewing.', fit: [3, 2, 2],
    decide: 'Buyers compare projects for weeks and speak to several agents. The one who calls first, with the right project, usually wins the viewing.',
    ex: ['Palm Residences · AED 2M–3M', 'Now launching: Palm Residences', 'Homes · Malls · Cafés'],
    uses: [['Matched to project and budget', 'Call or WhatsApp in one tap'], ['Launch emails to buyers', 'Payment-plan offers'], ['Launch video on the WiFi login', 'One tap to your project page']] },
  { name: 'Luxury Cars', img: '/images/industries/luxury-cars.webp', title: 'Drivers ready to book a test drive.', fit: [3, 1, 2],
    decide: 'Car buyers shortlist online, then visit one or two showrooms. Be on the shortlist, and call before the other dealer does.',
    ex: ['New SUV range · AED 180K–250K', 'Book a test drive this weekend', 'Malls · Cafés · Homes'],
    uses: [['Test-drive requests', 'Book the drive the same day'], ['New model launches', 'Year-end offers'], ['Full-screen video for a new model', 'In malls with showrooms']] },
  { name: 'Hospitality & Travel', img: '/images/industries/hospitality.webp', title: 'Guests planning their next stay.', fit: [1, 3, 2],
    decide: 'Stays and holidays are booked by season and often on impulse. The offer that lands while people plan their weekend gets the booking.',
    ex: ['Corporate stay · 20 guests', 'Your weekend escape', 'Cafés · Malls · Homes'],
    uses: [['Group and corporate bookings', 'Event enquiries'], ['Staycation packages', 'Long-weekend offers'], ['Offers on café and mall WiFi', 'One tap to booking']] },
  { name: 'Retail & E-commerce', img: '/images/industries/retail.webp', pos: '50% 35%', title: 'Shoppers, while they’re out shopping.', fit: [1, 2, 3],
    decide: 'Footfall comes from people nearby with time to browse. Reach them in the mall they are already in, the moment they connect.',
    ex: ['Sofa set · AED 15K–25K', 'The weekend sale starts Friday', 'Malls · Cafés · Staff housing'],
    uses: [['Buyers for big purchases', 'See what they want first'], ['Sale announcements', 'Traffic to your online shop'], ['Your offer on the mall WiFi', 'Timed around sales']] },
  { name: 'Banking & Finance', img: '/images/industries/finance.webp', title: 'Customers comparing before they apply.', fit: [3, 1, 2],
    decide: 'Financial products are researched before anyone applies. Speaking to people while they compare turns an enquiry into an account.',
    ex: ['Mortgage enquiry · AED 1.5M', 'Open a business account', 'Staff housing · Malls'],
    uses: [['Loan, card and mortgage enquiries', 'Call back while they compare'], ['Business account offers', 'Product launches'], ['Remittance offers in staff housing', 'Branch promotions']] },
  { name: 'Healthcare', img: '/images/industries/healthcare.webp', title: 'Patients looking for care, near your clinic.', fit: [3, 1, 2],
    decide: 'Clinics need booked appointments, not just awareness. Patients ask a few clinics, then book with the one that calls back first.',
    ex: ['Dental implants · AED 5K–10K', 'Full health check-up this month', 'Homes · Staff housing'],
    uses: [['Treatment enquiries', 'Bad lead? Credits back'], ['Health packages', 'New specialist news'], ['Check-up offers in communities', 'Packages in staff housing']] },
  { name: 'Education', img: '/images/industries/education.webp', title: 'Students and parents, ready to enrol.', fit: [3, 2, 1],
    decide: 'Families compare schools and courses for months before they commit. Be in the conversation early, and call when they ask.',
    ex: ['Grade 3 · Fees AED 40K–60K', 'Open day this Saturday', 'Homes · Malls · Cafés'],
    uses: [['Admission enquiries', 'Book campus visits'], ['Open days and intakes', 'Early-bird offers'], ['Open days on WiFi at home', 'One tap to admissions']] },
  { name: 'B2B & Corporate', img: '/images/industries/corporate.webp', title: 'Reach the people who sign off.', fit: [2, 3, 1],
    decide: 'Business buyers decide in small groups and take their time. Being in front of the right decision makers matters more than reaching everyone.',
    ex: ['Office fit-out · 4,000 sq ft', 'Cut your fleet costs', 'Malls · Cafés'],
    uses: [['Enquiries for your services', 'Call back while they compare'], ['Emails to decision makers', 'Event invites'], ['Brand awareness in malls and cafés']] },
];

const ranked = (fit: [Fit, Fit, Fit]) => [0, 1, 2].sort((a, b) => fit[b] - fit[a]);

const LOGO = '/images/brand/y5-logo.svg';

// Share of Y5Leads enquiries by the buyer's country (agreed 2 Nov 2026).
const countries = [
  { name: 'United Arab Emirates', pct: 80, color: '#0B261B', ink: '#C4F25A' },
  { name: 'Europe', pct: 9, color: '#2F6B00', ink: '#FFFFFF' },
  { name: 'United States', pct: 5, color: '#75B630', ink: '#0B1A10' },
  { name: 'Other GCC', pct: 3, color: '#A6E72A', ink: '#0B1A10' },
  { name: 'Asia', pct: 2, color: '#C9DDB5', ink: '#0B1A10' },
  { name: 'Rest of the world', pct: 1, color: '#DCE4DE', ink: '#0B1A10' },
];

const campaignAlso = ['finance & insurance', 'hospitality & travel', 'retail', 'technology', 'construction', 'professional services'];

const adsBars = [42, 55, 48, 61, 58, 66, 72, 64, 70, 78, 74, 83, 88, 95];
const adsIndustries = [
  { name: 'Retail & supermarkets', where: 'Malls · Cafés' },
  { name: 'Telecom', where: 'Malls · Homes · Staff accommodation' },
  { name: 'Banking & exchange houses', where: 'Staff accommodation · Malls' },
  { name: 'FMCG & beverages', where: 'Malls · Cafés · Homes' },
  { name: 'Electronics', where: 'Malls · Cafés' },
  { name: 'Real estate launches', where: 'Homes · Malls' },
];

// Keep in step with the open and click rates on the Y5Campaigns page (agreed 30 Oct 2026).
const rates = [
  { name: 'Real estate', open: [25, 30], click: 5.0 },
  { name: 'Automotive', open: [22, 27], click: 4.2 },
  { name: 'Healthcare', open: [21, 26], click: 3.8 },
  { name: 'Education', open: [20, 25], click: 3.5 },
];
---
<BaseLayout title="Industries" description="Which Y5Media service fits your industry: Y5Leads for ready buyers, Y5Campaigns for the right inboxes, Y5Ads on WiFi login screens across the UAE.">
  <PageHero
    kicker="Industries"
    title="The right service"
    accent="for how your industry sells."
    text="Some businesses need calls from ready buyers. Some need to land in the right inboxes. Some need to be seen where people spend their day. Find your industry to see where to start."
  >
    <Fragment slot="buttons">
      <a class="btn btn-primary" href="#industry-guide">Find your industry <span aria-hidden="true">↓</span></a>
      <a class="btn btn-ghost" href="/contact">Talk to us</a>
    </Fragment>
    <div class="collage" slot="side" aria-hidden="true">
      <div class="glow"></div>
      <div class="tile t-leads">
        <div class="frame">
          <video src="/video/industries-leads.mp4" muted loop autoplay playsinline preload="metadata"></video>
          <div class="cap"><b><i></i>Y5Leads</b><small>Calls from ready buyers</small></div>
        </div>
        <div class="chip chip-lead"><span>✓ New lead</span><b>Palm Residences</b><small>Budget AED 2M–3M</small></div>
      </div>
      <div class="tile t-camp">
        <div class="frame">
          <video src="/video/industries-campaigns.mp4" muted loop autoplay playsinline preload="metadata"></video>
          <div class="cap"><b><i></i>Y5Campaigns</b><small>Your offer in the right inboxes</small></div>
        </div>
        <div class="chip chip-rate">25–30% open rate</div>
      </div>
      <div class="tile t-ads">
        <div class="frame">
          <video src="/video/industries-ads.mp4" muted loop autoplay playsinline preload="metadata"></video>
          <div class="cap"><b><i></i>Y5Ads</b><small>Seen on the WiFi login</small></div>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="section guide" id="industry-guide">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker" data-reveal>Industry by industry</div>
          <h2 data-reveal>What works for <span class="accent">your industry.</span></h2>
        </div>
        <p class="lede" data-reveal>Pick your industry. Each one shows the service to start with, and how the other two help.</p>
      </div>

      <div class="ix" data-ix data-reveal>
        <div class="panel">
          <div class="list" role="tablist" aria-label="Industries" aria-orientation="vertical">
            {industries.map((ind, i) => {
              const best = services[ranked(ind.fit)[0]];
              return (
                <button type="button" class="pick" role="tab" id={`ix-tab-${i}`} aria-controls={`ix-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}>
                  <img src={ind.img} alt="" width="1000" height="750" loading="lazy" decoding="async" style={ind.pos && `object-position:${ind.pos}`} />
                  <span class="pick-copy"><b>{ind.name}</b><small><i class={`dot ${best.key}`}></i>Start with {best.name}</small></span>
                  <span class="bar" aria-hidden="true"></span>
                </button>
              );
            })}
          </div>
          <div class="panel-foot">
            <span class="count"><b data-ix-count>01</b> / {String(industries.length).padStart(2, '0')}</span>
            <span class="arrows">
              <button type="button" class="arrow" data-ix-prev aria-label="Previous industry"><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 11l5-5 5 5" /></svg></button>
              <button type="button" class="arrow" data-ix-next aria-label="Next industry"><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 7l5 5 5-5" /></svg></button>
            </span>
          </div>
        </div>

        <div class="stage">
          {industries.map((ind, i) => (
            <img class="stage-bg" src={ind.img} alt="" width="1000" height="750" loading="lazy" decoding="async"
              data-bg={i} data-active={i === 0 ? '' : undefined} style={ind.pos && `object-position:${ind.pos}`} />
          ))}
          <div class="shade"></div>
          {industries.map((ind, i) => (
            <div class="slide" role="tabpanel" id={`ix-panel-${i}`} aria-labelledby={`ix-tab-${i}`} data-slide={i}
              data-active={i === 0 ? '' : undefined} hidden={i !== 0}>
              <div class="slide-copy">
                <div class="slide-kicker">{ind.name}</div>
                <h3>{ind.title}</h3>
                <p>{ind.decide}</p>
              </div>
              <div class="cards">
                {ranked(ind.fit).map((k) => {
                  const s = services[k];
                  const best = ind.fit[k] === 3;
                  return (
                    <a class:list={['svc-card', s.key, { best }]} href={s.href}>
                      <span class="fit">{FIT[ind.fit[k]]}</span>
                      <b class="svc-name">{s.name}</b>
                      <ul>{ind.uses[k].map((u) => <li>{u}</li>)}</ul>
                      <span class="ex"><small>{s.exLabel}</small><b>{ind.ex[k]}</b></span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section sx" aria-labelledby="sx-leads">
    <div class="container">
      <header class="sx-head">
        <div class="sx-top" data-reveal>
          <div class="sx-logo leads"><img src={LOGO} alt="Y5" width="326" height="168" />Leads</div>
          <span class="sx-count">01 / 03</span>
        </div>
        <div class="sx-title" data-reveal>
          <h2 id="sx-leads">Verified buyers, from the UAE <span>and abroad.</span></h2>
          <a class="sx-link" href="/y5leads">Explore Y5Leads <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="lx-bento">
        <a class="lx-tile lx-re" href="/y5leads" data-reveal>
          <img src="/images/industries/real-estate.webp" alt="" width="1000" height="750" loading="lazy" decoding="async" />
          <span class="lx-label">Main focus</span>
          <span class="lx-body"><b>Real Estate</b><span>Buyers and investors matched to each project, off-plan to ready, in every emirate.</span></span>
          <span class="lx-lead" aria-hidden="true">
            <span class="lx-lead-top"><small>New lead</small><small class="ok"><i></i>Verified</small></span>
            <b>Palm Residences</b>
            <span>2-bed apartment · AED 2M–3M</span>
          </span>
        </a>
        <a class="lx-tile lx-auto" href="/y5leads" data-reveal data-reveal-delay=".06s">
          <img src="/images/industries/luxury-cars.webp" alt="" width="1000" height="750" loading="lazy" decoding="async" />
          <span class="lx-body"><small>Main focus</small><b>Automotive</b><span>Test drives for the models you sell</span></span>
        </a>
        <div class="lx-verified" data-reveal data-reveal-delay=".12s">
          <span class="ring r1" aria-hidden="true"></span><span class="ring r2" aria-hidden="true"></span>
          <span class="lx-big"><b>100%</b><span>of leads verified before they reach you</span></span>
          <small>Bad lead?<br />Credits back.</small>
        </div>
      </div>

      <figure class="lx-countries" data-reveal>
        <figcaption>
          <small>Where our buyers are</small>
          <span class="lx-uae"><b>80%</b><span>UAE</span></span>
          <span class="lx-note">The other 20% are overseas buyers, led by Europe and the United States.</span>
        </figcaption>
        <div class="lx-split">
          <div class="lx-bar" role="img" aria-label="Leads by country: UAE 80%, Europe 9%, United States 5%, other GCC 3%, Asia 2%, rest of the world 1%">
            {countries.map((c) => <span style={`flex-grow:${c.pct};background:${c.color};color:${c.ink}`}>{c.pct >= 9 ? `${c.pct}%` : ''}</span>)}
          </div>
          <ul class="lx-legend">
            {countries.map((c) => <li><i style={`background:${c.color}`}></i><span>{c.name}</span><b>{c.pct}%</b></li>)}
          </ul>
        </div>
      </figure>
    </div>
  </section>

  <section class="cx-wrap" aria-labelledby="sx-camp">
    <div class="cx">
      <span class="blob b1" aria-hidden="true"></span><span class="blob b2" aria-hidden="true"></span><span class="blob b3" aria-hidden="true"></span>
      <div class="cx-in">
        <header class="sx-head">
          <div class="sx-top" data-reveal>
            <div class="sx-logo camp"><img src={LOGO} alt="Y5" width="326" height="168" />Campaigns</div>
            <span class="sx-count">02 / 03</span>
          </div>
          <div class="sx-title" data-reveal>
            <h2 id="sx-camp">Emails people open, <span>industry by industry.</span></h2>
            <a class="sx-link" href="/y5campaigns#pricing">See pricing <span aria-hidden="true">→</span></a>
          </div>
        </header>

        <div class="cx-grid">
          <div class="cx-chart" data-reveal>
            <div class="cx-chart-head">
              <b>Typical open rate</b>
              <span><i></i>Open rate range<span>Click rate</span></span>
            </div>
            <div class="cx-rows">
              {rates.map((r) => (
                <div class="cx-row">
                  <span class="cx-name">{r.name}</span>
                  <span class="cx-track"><span class="cx-pill" style={`left:${(r.open[0] / 30) * 100}%;width:${((r.open[1] - r.open[0]) / 30) * 100}%`}>{r.open[0]}–{r.open[1]}%</span></span>
                  <b class="cx-click">{r.click.toFixed(1)}%</b>
                </div>
              ))}
              <div class="cx-row cx-axis" aria-hidden="true"><span></span><span class="cx-ticks"><span>0%</span><span>10%</span><span>20%</span><span>30%</span></span><span></span></div>
            </div>
            <p class="cx-foot">Typical results for a Y5Campaigns send. Your figures depend on your offer, the design and the day it lands.</p>
          </div>

          <div class="cx-fit" data-reveal data-reveal-delay=".08s">
            <small>Industries that fit</small>
            <ul>
              {rates.map((r) => <li><b>{r.name}</b><span>{r.open[0]}–{r.open[1]}% open</span></li>)}
            </ul>
            <p><b>Also:</b> {campaignAlso.join(' · ')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section sx ax" aria-labelledby="sx-ads">
    <div class="container">
      <header class="sx-head">
        <div class="sx-top" data-reveal>
          <div class="sx-logo ads"><img src={LOGO} alt="Y5" width="326" height="168" />Ads</div>
          <span class="sx-count">03 / 03</span>
        </div>
        <div class="sx-title" data-reveal>
          <h2 id="sx-ads">Seen the moment <span>people connect.</span></h2>
          <a class="sx-link" href="/y5ads">Explore Y5Ads <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="ax-bento">
        <div class="ax-video" data-reveal>
          <video src="/video/industries-ads.mp4" muted loop autoplay playsinline preload="metadata" aria-hidden="true"></video>
          <div class="ax-wifi" aria-hidden="true">
            <div><span class="ax-ico"><svg viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" /><circle cx="12" cy="19.5" r="1" /></svg></span><span><b>Mall Free WiFi</b><small>Your ad plays before they connect</small></span></div>
            <span class="ax-load"><i></i></span>
          </div>
        </div>
        <div class="ax-reach" data-reveal data-reveal-delay=".06s">
          <span class="ax-big"><small>Impressions served</small><b>50M+</b></span>
          <span class="ax-side"><span><b>50K+</b><small>WiFi hotspots</small></span><span><b>500+</b><small>UAE locations</small></span></span>
        </div>
        <div class="ax-report" data-reveal data-reveal-delay=".12s">
          <small>Example report</small>
          <div class="ax-bars" aria-hidden="true">{adsBars.map((v, i) => <span class:list={{ last: i === adsBars.length - 1 }} style={`height:${v}%`}></span>)}</div>
          <div class="ax-report-foot"><span>48,210 impressions</span><b>4.0% CTR</b></div>
        </div>
        <div class="ax-conv" data-reveal data-reveal-delay=".18s">
          <b>40–60%</b>
          <span>more conversion than other digital ads</span>
        </div>
      </div>

      <div class="ax-fit">
        <div class="ax-fit-copy" data-reveal>
          <small>Industries that fit</small>
          <p>Brands that need to be seen by a lot of people, in the places they spend their day.</p>
        </div>
        <ol class="ax-list" data-reveal>
          {adsIndustries.map((a, i) => (
            <li><a href="/y5ads"><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{a.name}</b><span class="w">{a.where}</span><span class="arr" aria-hidden="true">→</span></a></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <CtaBand title="Not sure where to start?" text="Tell us your industry and your goal. We’ll suggest one service or a mix, and what it would cost." />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-ix]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.pick')];
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const bgs = [...root.querySelectorAll<HTMLElement>('[data-bg]')];
    const count = root.querySelector<HTMLElement>('[data-ix-count]')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, n) => {
        const on = n === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      slides.forEach((s, n) => {
        const on = n === current;
        s.hidden = !on;
        s.toggleAttribute('data-active', on);
      });
      bgs.forEach((b, n) => b.toggleAttribute('data-active', n === current));
      count.textContent = String(current + 1).padStart(2, '0');
      if (focus) tabs[current].focus();
    };

    tabs.forEach((t, n) => {
      t.addEventListener('click', () => show(n));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); show(current + 1, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1, true); }
      });
      t.querySelector('.bar')!.addEventListener('animationend', () => { if (n === current) show(current + 1); });
    });
    root.querySelector('[data-ix-prev]')!.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-ix-next]')!.addEventListener('click', () => show(current + 1));

    if (!still) {
      root.classList.add('is-auto');
      const pause = (on: boolean) => root.classList.toggle('is-paused', on);
      root.addEventListener('pointerenter', () => pause(true));
      root.addEventListener('pointerleave', () => pause(false));
      root.addEventListener('focusin', () => pause(true));
      root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) pause(false); });
      const io = new IntersectionObserver(([entry]) => root.classList.toggle('is-offscreen', !entry.isIntersecting), { threshold: 0.2 });
      io.observe(root);
    }
  }
</script>

<style>
  .collage { position: relative; height: 520px; }
  .glow { position: absolute; left: 10%; top: 12%; width: 70%; height: 70%; border-radius: 50%; background: radial-gradient(closest-side, rgba(166, 231, 42, .22), transparent); filter: blur(30px); }
  .tile { position: absolute; animation: float-a 7s ease-in-out infinite; }
  .t-leads { left: 0; top: 30px; z-index: 2; width: 54%; height: 420px; }
  .t-camp { right: 0; top: 0; width: 48%; height: 230px; animation: float-b 8s ease-in-out infinite; }
  .t-ads { right: 5%; bottom: 0; width: 44%; height: 250px; animation-duration: 9s; animation-delay: 1s; }
  .frame { position: relative; width: 100%; height: 100%; border-radius: 26px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .7), 0 0 60px -20px var(--tile-glow); border: 1px solid var(--tile-edge); }
  .frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, var(--tile-shade)); }
  .t-leads { --tile-glow: rgba(196, 242, 90, .45); --tile-edge: rgba(196, 242, 90, .35); --tile-shade: rgba(11, 38, 27, .85); }
  .t-camp { --tile-glow: rgba(201, 182, 255, .5); --tile-edge: rgba(201, 182, 255, .4); --tile-shade: rgba(22, 11, 51, .85); }
  .t-ads { --tile-glow: rgba(238, 246, 230, .45); --tile-edge: rgba(238, 246, 230, .45); --tile-shade: rgba(11, 38, 27, .6); }
