  .sx-logo.camp { background: linear-gradient(135deg, rgba(22, 11, 51, .94), rgba(64, 44, 140, .82)); color: var(--white); border: 1px solid rgba(201, 182, 255, .5); box-shadow: 0 20px 44px -22px rgba(22, 11, 51, .7), 0 0 40px -18px rgba(201, 182, 255, .7), inset 0 1px 0 rgba(255, 255, 255, .2); }
  .sx-logo.ads { background: linear-gradient(135deg, rgba(238, 246, 230, .98), rgba(206, 232, 184, .9)); color: #0B1A10; border: 1px solid rgba(47, 107, 0, .3); box-shadow: 0 20px 44px -22px rgba(47, 107, 0, .45), inset 0 1px 0 var(--white); }
