  .lx-lead { right: 28px; top: 28px; width: 250px; display: grid; gap: 6px; padding: 14px 16px; border-radius: 16px; background: rgba(255, 255, 255, .94); color: var(--ink); box-shadow: 0 24px 50px -20px rgba(0, 0, 0, .5); }
