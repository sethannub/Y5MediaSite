  .svc-card.camp { --acc: var(--violet); background: rgba(22, 11, 51, .88); color: var(--white); --muted: #C8BCEB; --ex: rgba(255, 255, 255, .07); --tag: rgba(255, 255, 255, .12); --tag-ink: #E4DDFA; --best-ink: var(--plum); }
  .svc-card.ads { --acc: var(--green-ink); background: rgba(238, 246, 230, .95); color: #0B1A10; --muted: var(--gray-600); --ex: rgba(11, 38, 27, .06); --tag: rgba(11, 38, 27, .08); --tag-ink: var(--green-ink); --best-ink: var(--white); }
