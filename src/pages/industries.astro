  .b2 { width: 420px; height: 420px; left: -120px; bottom: -200px; background: radial-gradient(closest-side, rgba(201, 182, 255, .9), transparent); }
  .b3 { width: 260px; height: 260px; left: 40%; top: 30%; background: radial-gradient(closest-side, rgba(255, 255, 255, .7), transparent); }
