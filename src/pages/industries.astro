  .pick:hover { background: var(--gray-50); }
  .pick[aria-selected='true'] { background: var(--forest); color: var(--white); box-shadow: 0 18px 30px -18px rgba(11, 38, 27, .8); }
  .pick img { width: 44px; height: 44px; border-radius: 12px; object-fit: cover; flex: none; }
  .pick-copy { display: grid; gap: 2px; min-width: 0; }
