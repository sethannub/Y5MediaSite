  @keyframes float-a { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes float-b { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }

  .guide { background: radial-gradient(50rem 28rem at 85% 0%, rgba(117, 182, 48, .10), transparent 70%), radial-gradient(40rem 24rem at 0% 100%, rgba(201, 182, 255, .10), transparent 70%), var(--paper); }
