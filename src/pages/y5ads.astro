---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import WifiPhone from '../components/mocks/WifiPhone.astro';
import Venues from '../components/home/Venues.astro';
import Industries from '../components/home/Industries.astro';
import CtaBand from '../components/CtaBand.astro';
import AdsStats from '../components/y5ads/AdsStats.astro';
import AdsAttention from '../components/y5ads/AdsAttention.astro';
import AdsAdvantages from '../components/y5ads/AdsAdvantages.astro';
import AdsSetup from '../components/y5ads/AdsSetup.astro';
import AdsNetwork from '../components/y5ads/AdsNetwork.astro';
import { site, products } from '../config/site';
import { wifiSteps } from '../config/content';
---
<BaseLayout title={products.wifi.name} description="Put your banner or video ad on the WiFi login screen in malls, cafés, homes and staff accommodation across the UAE, and see every impression and click.">
  <PageHero
    kicker={products.wifi.name}
    title="Advertising that meets people"
    accent="where they connect."
    text={products.wifi.summary}
  >
    <Fragment slot="buttons">
      <a class="btn btn-primary" href="/contact?interest=y5ads">Plan a campaign</a>
      <a class="btn btn-glass" href="#venues">See the audiences</a>
    </Fragment>
    <ul class="facts" slot="side">
      <li><b>50K+</b><span>WiFi hotspots in malls, cafés, homes and staff accommodation</span></li>
      <li><b>500+</b><span>locations across the UAE</span></li>
      <li><b>5</b><span>formats: banner, video, SMS, email and vouchers</span></li>
    </ul>
  </PageHero>

  <AdsStats />
  <AdsAttention />

  <Journey
    id="wifi-journey"
    kicker="How it works"
    title="From a WiFi login"
    accent="to your website."
    text="Four steps, from the moment someone connects to the numbers in your report."
    steps={wifiSteps}
    tone="light"
    cta={{ label: 'Plan a campaign', href: '/contact?interest=y5ads' }}
  >
    <WifiPhone slot="stage" />
  </Journey>

  <AdsAdvantages />
  <AdsSetup />
  <AdsNetwork />
  <Venues cta={{ label: 'Plan a campaign', href: '/contact?interest=y5ads' }} />

  <section class="section report">
    <div class="container grid">
      <div>
        <div class="kicker" data-reveal>Campaign reports</div>
        <h2 data-reveal>Detailed reporting, <span class="accent">in plain numbers.</span></h2>
        <p class="lede" data-reveal>
          Your report breaks the campaign down by visits, impressions, clicks, devices, operating systems and phone
          models, so you can see exactly who saw your ad.
        </p>
        <a class="btn btn-dark" href="/contact?interest=y5ads" data-reveal>Ask for a sample report</a>
      </div>
      <div class="shot" data-reveal>
        <img class="main" src="/images/brand/y5ads-reports.png" alt="Y5Ads campaign report with impression charts" width="553" height="619" loading="lazy" />
        <img class="pop" src="/images/brand/graph03.png" alt="" width="225" height="230" loading="lazy" />
      </div>
    </div>
  </section>

  <Industries links={false} />
  <CtaBand title="Put your brand on the screen people check first." text={`Tell us who you want to reach and when. We’ll come back with venues, formats and a price. Or call us on ${site.contact.phone}.`} />
</BaseLayout>

<style>
  .facts { list-style: none; display: grid; gap: 12px; }
  .facts li {
    display: grid; grid-template-columns: 112px 1fr; align-items: center; gap: 16px; padding: 18px 20px;
    border-radius: var(--radius-md); background: var(--glass); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow);
  }
  .facts b { font-family: var(--font-display); font-size: 38px; font-weight: 600; line-height: 1; color: var(--lime); }
  .facts span { color: var(--on-dark-muted); font-size: 15px; }
  .report .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .report .lede { margin: 18px 0 28px; }
  .shot { position: relative; padding: 32px 32px 0; border-radius: var(--radius-lg); background: var(--forest-glow), var(--forest); overflow: hidden; height: 460px; }
  .shot .main { width: 78%; border-radius: 14px 14px 0 0; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6); }
  .shot .pop { position: absolute; width: 34%; right: 6%; top: 30%; border-radius: 12px; background: #fff; box-shadow: 0 20px 40px -12px rgba(0, 0, 0, .5); }
  @media (max-width: 900px) { .report .grid { grid-template-columns: 1fr; } .shot { height: 360px; } }
</style>
