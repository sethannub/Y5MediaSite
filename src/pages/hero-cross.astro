---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCross from '../components/home/HeroCross.astro';
---
<BaseLayout title="Hero option B · Crossed divider">
  <HeroCross />
  <nav class="mock-switch" aria-label="Hero options">
    <span>Hero mockup</span>
    <a href="/hero-slant" aria-current={Astro.url.pathname.includes('hero-slant') ? 'page' : undefined}>A · Slanted</a>
    <a href="/hero-cross" aria-current={Astro.url.pathname.includes('hero-cross') ? 'page' : undefined}>B · Crossed</a>
    <a href="/hero-wave" aria-current={Astro.url.pathname.includes('hero-wave') ? 'page' : undefined}>C · Diagonal</a>
    <a href="/hero-motion" aria-current={Astro.url.pathname.includes('hero-motion') ? 'page' : undefined}>D · Motion</a>
    <a href="/">Current</a>
  </nav>
</BaseLayout>

<style>
  .mock-switch {
    position: fixed; z-index: 60; right: 20px; bottom: 20px;
    display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 999px;
    background: rgba(11, 38, 27, .9); border: 1px solid var(--glass-border); box-shadow: 0 16px 40px -12px rgba(0, 0, 0, .6);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); font-size: 13px;
  }
  .mock-switch span { color: var(--on-dark-faint); padding: 0 10px; font-weight: 600; }
  .mock-switch a { color: var(--on-dark-muted); padding: 8px 14px; border-radius: 999px; font-weight: 600; }
  .mock-switch a:hover { color: var(--white); }
  .mock-switch a[aria-current='page'] { background: var(--lime); color: #0B1A10; }
</style>
